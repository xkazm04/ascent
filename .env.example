# ─────────────────────────────────────────────────────────────────────────────
# Ascent — environment variables
# Copy to .env.local and fill in. Everything is optional: with no keys at all,
# Ascent runs in deterministic "mock" mode — fully functional, just without
# LLM-written nuance.
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM backend to use:
#   gemini     -> Google Gemini       (LOCAL DEV & TESTING — recommended here)
#   bedrock    -> AWS Bedrock/Claude   (PHASE 2 / production, enterprise privacy)
#   claude-cli -> local `claude` CLI   (LOCAL EVAL — uses your Pro/Max subscription)
#   openai     -> OpenAI or any OpenAI-compatible Chat Completions API
#   mock       -> deterministic, keyless
#   auto       -> (default) gemini if a key is present, else mock
# Production runs `gemini` (the default model is a fast Flash variant — see below — so a live scan
# fits the serverless function budget) with `bedrock` as the failover. Keep `gemini` locally too.
LLM_PROVIDER=gemini

# Optional cross-provider tuning:
# LLM_FALLBACK_PROVIDER=bedrock  # retry with this provider if the primary errors (prod: bedrock; or mock)
# LLM_TIMEOUT_MS=120000          # per-call timeout for the gemini/openai HTTP clients (ms)

# ── claude-cli provider (local eval via subscription) — see docs/features/scanning/calibration.md ──
# Requires the `claude` CLI installed + logged in (claude /login). Spawns it headlessly;
# uses your subscription, NOT pay-per-token, as long as ANTHROPIC_API_KEY is unset.
# CLAUDE_MODEL=sonnet           # or opus, or a pinned id like claude-sonnet-4-6
# CLAUDE_CLI_PATH=claude        # override if not on PATH
# CLAUDE_CLI_TIMEOUT_MS=120000

# ── Gemini (local dev) ───────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY (whichever is set is used).
# Optional: override the model (default gemini-3-flash-preview; GA: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3-flash-preview

# ── OpenAI (or any OpenAI-compatible endpoint) — set LLM_PROVIDER=openai ──────
# Works with OpenAI proper or a compatible gateway (Azure OpenAI, OpenRouter, or a local
# server like Ollama / LM Studio that speaks the Chat Completions API).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini          # model id (any chat-completions model your endpoint serves)
# OPENAI_BASE_URL=                  # override the API base for a compatible endpoint

# ── AWS Bedrock (Phase 2 / enterprise) ───────────────────────────────────────
# Uses your standard AWS credentials (AWS_PROFILE / AWS_ACCESS_KEY_ID + SECRET,
# or an IAM role on Vercel/AWS). Default model is the latest Claude Sonnet (4.6)
# via the US geo inference profile (data stays in-US, works in us-east-1).
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
#   alternatives: global.anthropic.claude-sonnet-4-6  (max throughput)
#                 eu.anthropic.claude-sonnet-4-6      (EU residency)

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Raises API rate limits for public scans. Fine-grained token, read-only
# "Contents" + "Metadata".
# GITHUB_TOKEN=

# ── GitHub App (private repositories) — see docs/features/github/setup.md ───────────────
# Lets users install Ascent on their org to scan private repos via short-lived
# installation tokens. Requires DATABASE_URL. Public scans don't need this.
#
# Permissions the App needs, by feature:
#   • Scanning private repos        → Contents: read, Metadata: read, Pull requests: read
#   • PR maturity gate (checks/comment) → Checks: write, Pull requests: write
#   • Practice "open starter PR"    → Contents: write, Pull requests: write
# Webhook events to subscribe to: Installation, Pull request, Push.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=ascent-maturity
# GITHUB_APP_WEBHOOK_SECRET=
# Base64-encoded PEM (recommended) or raw PEM with \n escapes:
# GITHUB_APP_PRIVATE_KEY=

# ── GitHub OAuth (sign-in) — see docs/features/github/setup.md §4 ──────────────────────
# Reuse the SAME GitHub App's Client ID + a generated client secret, so a signed-in
# user's token can list THEIR installations. Set the App's Callback URL to
# {host}/api/auth/callback. AUTH_SECRET signs the session cookie (any long random string,
# e.g. `openssl rand -base64 32`). When unset, the app runs without sign-in (pages open).
# NOTE: this is the LEGACY custom OAuth flow. It is kept but dormant — the active login is
# Supabase (below). Leave these unset unless you specifically want the custom flow.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# AUTH_SECRET=

# ── Supabase GitHub OAuth (ACTIVE sign-in) — the login wall ──────────────────
# The active authentication layer. When both vars below are set (and ASCENT_AUTH_BYPASS is
# off), private/org scans and all /org/* features require signing in with GitHub via Supabase;
# public-repo scans stay free / no-signup. When unset, the app runs open exactly as before.
#
# Supabase dashboard prerequisite (one-time): Authentication → Providers → enable GitHub and
# paste a GitHub OAuth App's Client ID/secret (its callback = {SUPABASE_URL}/auth/v1/callback);
# then Authentication → URL Configuration → add {host}/auth/callback to the Redirect URLs
# (e.g. http://localhost:3000/auth/callback).
#
# The anon key is public by design (Row-Level Security protects data) — safe to expose client-side.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev/local only: bypass the Supabase login wall entirely — every gate passes as a synthetic
# "developer" viewer, so all functionality is reachable without signing in. Default OFF. Set to 1
# during development; set to 0 (or remove) to exercise the real sign-in flow.
# ASCENT_AUTH_BYPASS=1

# ── Autoscans + live intelligence (enterprise) ──────────────────────────────
# Vercel Cron hits /api/cron/rescan (see vercel.json). Set a secret to protect it;
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=
#
# Regression alerts (Feature: live intelligence). After an autoscan or a push-triggered
# re-scan, Ascent diffs the new report against the prior one; on a regression (level demotion,
# slide into "ungoverned", or a material score drop) it POSTs a Slack-compatible message here.
# Unset = alerts are computed + audit-logged but not dispatched. A Slack incoming-webhook URL works.
# An EMAIL sink is also accepted here and in each org's own sink field: `mailto:alerts@yourco.dev`
# routes regression/digest/low-credit/goal/spend pushes to that ONE address by email instead of
# POSTing. It still sends nothing unless an email provider is configured below.
# ALERT_WEBHOOK_URL=
#
# Multiple of the trailing 3-week average that trips the weekly spend-anomaly alert (min 10 scans
# in the period). Blank/invalid = 2, never 0. Unset = the default.
# SPEND_ANOMALY_RATIO=2
#
# Public base URL of this deployment — used to build absolute links in alerts + PR check
# "details" URLs (e.g. https://ascent.yourco.dev). Falls back to relative links when unset.
# ASCENT_PUBLIC_URL=
# NEXT_PUBLIC_APP_URL is accepted as a fallback alias for ASCENT_PUBLIC_URL (also used by
# robots.ts / sitemap.ts to emit absolute URLs).
#
# Contact address for the deployment. Powers the Enterprise "Contact us" mailto on /pricing and the
# contact line on /privacy and /terms. When unset those surfaces degrade gracefully (Enterprise CTA
# falls back to "Learn more" → /about; the legal pages fall back to the GitHub issue tracker) — set
# it so prospects can actually reach you.
# ASCENT_CONTACT_EMAIL=you@example.com
#
# Curated demo org showcased across the marketing surface — the header "Org demo" link, the landing
# org-preview cards, the /about CTAs, the onboarding "just show me" path, and the 404 fallback all link
# to /org/<this>. NEXT_PUBLIC_ so it inlines into client bundles. Defaults to "vercel" (populated by
# scripts/seed-fleet.mjs / seed-org.mjs); point it at any org you've actually scanned so the demo links
# resolve to a real, populated dashboard rather than dead-ending.
# NEXT_PUBLIC_DEMO_ORG=vercel

# ── Email (scan completion, org invites, alert sinks) ────────────────────────
# Pluggable EmailSender (src/lib/email). When the user opts into "email me when it's done", the
# completion email (a link to the report) is sent through the selected provider. UNCONFIGURED (dev,
# or prod before SES is wired) = a no-op that LOGS the would-be send — the feature never blocks a scan.
# EMAIL_PROVIDER=auto                   # auto (ses if SES_FROM_EMAIL set, else noop) | ses | noop
# SES_FROM_EMAIL=Ascent <no-reply@yourco.dev>   # verified SES sender; its presence enables real sends
# SES_REGION=us-east-1                  # falls back to AWS_REGION / AWS_DEFAULT_REGION / us-east-1
# AWS credentials come from the standard chain (AWS_PROFILE / AWS_ACCESS_KEY_ID+SECRET / IAM role),
# the same as Bedrock. EMAIL_TIMEOUT_MS caps a single send (default 10000) so it can't delay a scan.
#
# EVERYTHING that sends mail goes through this one provider selection, and NOTHING sends when it is
# unconfigured. The other two senders:
#   - Org invites (POST /api/org/invites with an `email`): one transactional message to the address
#     the owner typed. Suppress per-request with `notify: false`, or deployment-wide with:
# EMAIL_INVITES=off
#   - Org alert mail (an org whose alert sink is a `mailto:` — see ALERT_WEBHOOK_URL above). Each of
#     those carries a one-click unsubscribe that CLEARS that org's sink; the link is signed with the
#     key below. Unset = no unsubscribe link is minted and /api/email/unsubscribe answers 503 (so an
#     unauthenticated mutation endpoint never exists on a deploy that never mailed a token).
# EMAIL_UNSUBSCRIBE_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# EASIEST local dev: an embedded in-process PGlite (Postgres-in-WASM) — no Postgres install, no
# separate server. Set PGLITE_DATA_DIR and `npm run dev` boots it (src/instrumentation.ts) and
# persists to that folder. DATABASE_URL must still be set (a dummy is fine — the PGlite driver adapter
# provides the connection and the URL is ignored). Seed real data with `npm run db:local:seed` (uses
# the configured LLM provider; set LLM_PROVIDER=claude-cli to use your Claude subscription).
PGLITE_DATA_DIR=.pglite/ascent
DATABASE_URL=postgresql://pglite@127.0.0.1:5432/ascent
# SCAN_MAX_CACHE_AGE_DAYS=7             # re-scan an unchanged repo after N days (cache freshness). 0 = never.
# PUSH_RESCAN_MIN_INTERVAL_MINUTES=15   # debounce window for push-triggered rescans (G1-05). 0 = disabled.

# --- Canonical org time zone (G4-07) -------------------------------------------------------------
# One zone per deployment decides every day boundary: window presets, custom-range parsing, due-date
# buckets, digest weeks. Defaults to UTC — NOT the host's local zone, which is a deployment accident
# that made identical data bucket differently in dev and prod. An unknown zone degrades to UTC.
# ASCENT_ORG_TZ=UTC             # any IANA name, e.g. America/New_York

# --- Executive-briefing LLM narrative (G5-03) -----------------------------------------------------
# Off unless BOTH of these are set, so there is no network I/O by default (including in CI). Every
# numeric token the model emits is checked against the briefing's own figures before it is shown; an
# ungrounded, refused, malformed or failed response falls back to deterministic copy, never an error.
# BRIEFING_NARRATIVE=1
# ANTHROPIC_API_KEY=

# --- Cross-instance rate limiting (G1-04) --------------------------------------------------------
# The burst/per-IP window is always in-memory. The GLOBAL spend ceiling is per-instance unless a
# shared store is configured below, in which case the whole fleet shares one budget.
# Without credentials the limiter silently stays in-memory (the dev/test default).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ASCENT_RATE_LIMIT_SHARED_FAIL_OPEN=1  # degrade to the in-memory ceiling if the shared store is
                                        # unreachable. Default is FAIL CLOSED: reject rather than
                                        # reopen the instances x limit hole on paid-inference routes.

# --- Conformance ingest (G2-02) ------------------------------------------------------------------
# CONFORMANCE_INGEST_STRICT=1           # require a per-org askl_ API token bound to the org being
                                        # written. Default accepts the legacy deployment-wide
                                        # CONFORMANCE_INGEST_TOKEN with a deprecation warning.
#
# Alternatives to PGlite:
#   • a real local Postgres (docker-compose.yml): DATABASE_URL=postgres://ascent:ascent@localhost:5432/ascent (unset PGLITE_DATA_DIR)
#   • production: Aurora DSQL (Postgres-compatible; no local emulator, perpetual free tier) — set DSQL_ENDPOINT below.
#
# Aurora DSQL IAM auth (production). Setting DSQL_ENDPOINT switches the Prisma client into
# token-refresh mode: the connection password is a short-lived IAM token, minted via
# @aws-sdk/dsql-signer (run `npm i @aws-sdk/dsql-signer`) and auto-refreshed before its TTL
# elapses — so the cached client never goes stale after deploy. See src/lib/db/client.ts and
# docs/ARCHITECTURE.md §3-4. Region falls back to AWS_REGION / AWS_DEFAULT_REGION.
# DSQL_ENDPOINT=                        # cluster host, e.g. abc123.dsql.us-east-1.on.aws
# DSQL_REGION=us-east-1
# DSQL_USER=admin                       # admin -> admin auth token; otherwise db-connect token
# DSQL_DATABASE=postgres
# DSQL_PORT=5432
# DSQL_SSLMODE=require
# DSQL_TOKEN_TTL_SECONDS=900            # token lifetime requested from the signer (~15 min)
# DSQL_REFRESH_MARGIN_SECONDS=120       # refresh this long before the token expires

# ── Supply-chain scanning (org Security tab — Dependabot advisories) ─────────
# Surfaces open Dependabot advisory counts per repo on the Security tab as a SEPARATE signal — it does
# NOT change the D9 score. Live mode requires the GitHub App to be granted "Dependabot alerts: read".
#   github -> live alerts via the org's installation token
#   mock   -> deterministic demo data (labelled "demo" in the UI)
#   off    -> (default) no supply-chain card
# SUPPLY_CHAIN_PROVIDER=off

# ── Sentry (production error monitoring) ─────────────────────────────────────
# Runtime error capture only (no build plugin / source-map upload). BOTH unset = Sentry is a
# complete no-op — nothing initializes, no network traffic — so local dev and CI need neither.
# Set both in Vercel prod to the SAME DSN (from Sentry: Project → Settings → Client Keys).
# SENTRY_DSN=                    # server-side capture (src/instrumentation.ts)
# NEXT_PUBLIC_SENTRY_DSN=        # browser capture (src/instrumentation-client.ts); DSNs are
#                                # publishable by design — safe to inline into client bundles.

# ── LightTrack (LLM call tracking — src/lib/llm/tracklight.ts) ───────────────
# Mirrors every real provider.assess() call in the scan pipeline to a LightTrack instance
# (self-hosted LLM observability + cost tool) for per-model/per-repo cost + latency rollups.
# Fire-and-forget and best-effort: never blocks or fails a scan. DISABLED unless configured —
# set these in Vercel prod (names only here; never commit values) to enable tracking there.
# Auto-enables when LIGHTTRACK_PROJECT or LIGHTTRACK_KEY is set; LIGHTTRACK_ENABLED overrides.
# LIGHTTRACK_ENABLED=1           # explicit on/off override of the auto-enable heuristic
# LIGHTTRACK_URL=                # base URL of the API (default http://127.0.0.1:8787)
# LIGHTTRACK_PROJECT=            # project id (a scoped project key overrides it)
# LIGHTTRACK_KEY=                # Bearer key (enforced-auth or a scoped project key)

# ── Cost metering (the /usage dollar estimate) ───────────────────────────────
# Per-million-token prices used to turn recorded token usage into a $ estimate. Set these to your
# actual negotiated rates; unset = a built-in default. Input/output priced separately.
# LLM_INPUT_COST_PER_MTOK=0.30
# LLM_OUTPUT_COST_PER_MTOK=2.50

# ── Retention / pruning (DB housekeeping; driven by /api/cron/purge) ──────────
# RETENTION_MAX_SCANS_PER_REPO=        # keep at most N scans per repo (older ones pruned). Unset = keep all.
# RETENTION_AUDIT_DAYS=                # delete audit-log rows older than N days. Unset = keep all.
# RETENTION_BATCH_SIZE=500             # rows deleted per pruning batch.

# ── Public-scan weekly soft gate (anonymous free funnel; per-IP, persistent) ──
# Caps anonymous PUBLIC scans at N per rolling 7-day window per client IP (a salted-hash key — the
# raw IP is never stored). A deliberately SOFT, knowingly-attackable nudge layered ON TOP of the
# per-minute in-memory burst limiter; requires a configured DB and fails OPEN if the store errors.
# See src/lib/public-scan-quota.ts.
# PUBLIC_SCAN_WEEKLY_LIMIT=3            # free public scans per ANONYMOUS IP per 7 days. Default 3.
# PUBLIC_SCAN_WEEKLY_LIMIT_SIGNED_IN=20 # elevated allowance for a SIGNED-IN viewer (per-user bucket).
#                                       # Default 20; clamped to never drop below the anonymous limit.
# PUBLIC_SCAN_QUOTA_SALT=               # salt for the stored hashes. Set a real secret in prod.
# PUBLIC_SCAN_QUOTA_DISABLED=           # set to 1 to turn the weekly gate off entirely.

# Local/demo only: open per-org dashboards (/org/<slug>) when OAuth is NOT configured. Default off.
# Required for the seeding + org-e2e workflow (auth-off) to READ a seeded org dashboard; leave
# unset in any real deployment so a dropped AUTH_SECRET can never make per-tenant data public.
# ASCENT_OPEN_ORG_DASHBOARDS=1

# Dev/demo only: allow owner-gated MANUAL scan-credit grants via POST /api/org/credits/grant. Default
# off — in production, prepaid scan credits are added by the Polar top-up flow (see docs/features/billing/billing.md),
# never a self-serve endpoint. Enable this to seed credits locally for testing.
# ASCENT_ALLOW_CREDIT_GRANTS=1

# Dev/demo only: allow owner-gated MANUAL plan-tier changes via POST /api/org/plan (the org dashboard's
# Plan switcher). Default off — paid upgrades normally flow through Polar checkout. With this set, an
# owner can move Free→Pro→Team→Enterprise to demo how the monthly scan allowance changes. A downgrade to
# "free" is always allowed; only upgrades to a paid/unlimited tier are gated by this flag.
# ASCENT_ALLOW_PLAN_CHANGES=1

# Dev/demo only: the synthetic-fleet seeder (POST /api/dev/seed-fleet; `npm run db:seed:fleet`). It
# generates a large org of repos with back-dated scan histories + a curated set of public repos, so the
# org dashboards (Overview/Trajectory/Repositories/Live War Room) and the landing register render at
# scale. With no secret set it runs only OUTSIDE production. Set a secret to run it ONCE against a
# deployed instance (sent as the x-seed-secret header / ?secret= by the script).
# ASCENT_SEED_SECRET=

# Operator diagnostics: GET /api/kpi returns the eight adopted product KPIs (activation, re-scan,
# conversion, fleet depth, roadmap engagement, weekly active orgs, LLM cost/scan, pipeline error
# rate) plus the Polar price-drift check as JSON. FAIL-CLOSED: with no secret set the route answers
# 503 to everyone. Send it as `Authorization: Bearer <secret>` (header only — never a query param).
# ASCENT_OPS_SECRET=

# ── Billing (Polar — prepaid scan-credit purchases) — see docs/features/billing/billing.md ─────
# "Buy credits" stays OFF until POLAR_ACCESS_TOKEN and POLAR_CREDIT_PACKS are both set; without them the
# org dashboard simply hides the packs (everything else works). Sandbox by default. One-time setup:
#   1. Create a Polar account + Organization and switch it to the SANDBOX environment.
#   2. Create an Organization Access Token (sandbox)              -> POLAR_ACCESS_TOKEN
#   3. Create one product per credit pack (e.g. 100 / 500 / 2000 credits); map each product id to the
#      credits it grants in POLAR_CREDIT_PACKS (comma-separated "<productId>=<credits>" pairs).
#   4. Add a webhook (sandbox) -> {host}/api/billing/webhook, subscribe to "order.paid", and copy its
#      signing secret                                              -> POLAR_WEBHOOK_SECRET
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox                   # sandbox (default) | production
# POLAR_CREDIT_PACKS=                    # e.g. prod_abc=100,prod_def=500,prod_ghi=2000
