#!/bin/sh
# Delivery-contract gate (docs/DEPLOY.md "Delivery contract").
# A push to master IS the release: Vercel's Git integration builds and ships it regardless of CI's
# verdict, so the blocking gate has to run BEFORE the push leaves this machine. This hook runs
# `npm run verify` (lint, typecheck, tests+coverage, build — CI's blocking set; keep the two in
# lockstep, see .github/workflows/ci.yml) before any push that updates refs/heads/master. Other
# branches push freely; CI covers them.
#
# Escape hatch (emergencies only — record the reason in the pushed commit message or docs/DEPLOY.md):
#   ASCENT_SKIP_GATE=1 git push ...

targets_master=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master) targets_master=1 ;;
  esac
done

[ "$targets_master" = "1" ] || exit 0

if [ "$ASCENT_SKIP_GATE" = "1" ]; then
  echo "=====================================================================" >&2
  echo "pre-push: ASCENT_SKIP_GATE=1 — the master gate is being SKIPPED." >&2
  echo "pre-push: npm run verify (lint, typecheck, tests+coverage, build) was" >&2
  echo "pre-push: NOT run. Vercel will ship this push regardless of CI." >&2
  echo "pre-push: RECORD THE REASON (commit message or docs/DEPLOY.md) NOW." >&2
  echo "=====================================================================" >&2
  exit 0
fi

echo "pre-push: push targets master — running the gate: npm run verify (lint, typecheck, tests+coverage, build)..." >&2

# git exports GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE / GIT_PREFIX into hooks. The lane
# tests (lane-commit, lane-install, loop-land) run `git init` + `git commit` in temp
# directories, and with those variables inherited every such call lands on THIS repo
# instead of the temp one: 34 tests failed inside the hook that pass outside it
# (measured 2026-09-03). Drop the inherited pointers before the gate runs.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
npm run verify || {
  echo "pre-push: verify failed — push to master blocked (Vercel would have shipped it anyway)." >&2
  echo "pre-push: fix the failure, or in a genuine emergency: ASCENT_SKIP_GATE=1 git push (record why)." >&2
  exit 1
}

echo "pre-push: gate green — pushing." >&2
exit 0
