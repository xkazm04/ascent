// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildDigestMailPart: the weekly artefact as the mail body > fixture snapshot: the rendered body is stable 1`] = `"<p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5"><strong style="font-size:24px;color:#fff">62/100</strong> · L3 Established · 72nd percentile</p><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5">+4 this week (measured over 8 repositories scanned on both sides of the week; 2 onboarded; 1 departed)</p><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5">AI Adoption 54 (+6) · Engineering Rigor 68 (-1)</p><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5">10/12 repositories scanned · 14 scans this week · generated 2026-09-01</p><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5">⚠ 3 of 10 repositories were scored by the mock engine.</p><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5"><em>On pace for L4 by November (moderate confidence).</em></p><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Controls that failed this week (1)</h2><ul style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li>acme/api: Branch protection (was pass)</li></ul><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5">Coverage: 42 observations across 6 repo/control pairs, largest gap 3d.</p><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Standing concerns (1): observed, cause not attributed</h2><ul style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li>acme/web: D9 held 21 points below its earlier reading<br><span style="color:#94a3b8">scan 2026-08-01: 71<br>scan 2026-08-30: 50</span></li></ul><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Score deltas per dimension</h2><table role="presentation" style="width:100%;border-collapse:collapse;margin:0 0 8px"><tr><th style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#94a3b8;font-weight:600;text-align:left">Dimension</th><th style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#94a3b8;font-weight:600;text-align:right">Now</th><th style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#94a3b8;font-weight:600;text-align:right">This week</th></tr><tr><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1">D1 Testing</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">74</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">+5 over 8 repositories</td></tr><tr><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1">D3 Context Engineering</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">58</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">flat (within noise) over 8 repositories</td></tr><tr><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1">D4 Security Posture</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">66</td><td style="padding:4px 8px 4px 0;border-bottom:1px solid #334155;font-size:13px;color:#cbd5e1;text-align:right">not measured</td></tr></table><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Follow-ups</h2><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5">Closed this week: 2 (1 by rescan, 1 by hand) · Dismissed: 1</p><ul style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li>Add a CI test gate, acme/api (D1)</li><li>Document the deploy path, acme/web (D2)</li></ul><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5">Opened this week: 1 (2 repositories had no earlier scan and are not counted)</p><ul style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li>No CODEOWNERS file, acme/infra (D4)</li></ul><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Next actions</h2><ol style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li><strong>Recommended next move:</strong> Roll out the test gate to 4 repositories.</li><li>Write the deploy runbook in 3 repositories.</li></ol><h2 style="margin:22px 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8">Repository movement</h2><ul style="margin:0 0 8px;padding-left:20px;font-size:14px;color:#cbd5e1;line-height:1.5"><li>▲ api +9 (L2→L3)</li><li>▼ web -7</li><li>○ docs +1 (held)</li><li>+ fresh (onboarded)</li></ul><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5">8 repositories compared</p><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5">Credits remaining: 3, top up to keep autoscans flowing.</p><p style="margin:0 0 8px;font-size:15px;color:#cbd5e1;line-height:1.5"><a href="https://ascent.test/org/acme?tab=digest" style="color:#22d3ee">Open the weekly digest in Ascent</a></p><p style="margin:0 0 8px;font-size:13px;color:#94a3b8;line-height:1.5">Window [2026-08-26, 2026-09-01] in the org's canonical zone. Fleet averages are over scanned repositories; deltas compare each repository's latest scan with its latest scan before 2026-08-26. Follow-up history for 1 repository was unreadable and is excluded.</p>"`;
