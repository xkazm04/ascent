    "masthead-figure": { "selector": "[data-role='practices-v2'] [data-kit='masthead'] [data-kit='display'][data-level='figure']", "expect": { "fontSize": 28, "fontWeight": "300" } },
    "eyebrow": { "selector": "[data-role='practices-v2'] [data-kit='eyebrow']", "expect": { "fontSize": 14, "textTransform": "none" } },
    "section-statement": { "selector": "[data-role='practices-v2'] [data-kit='section-head'] [data-kit='display'][data-level='section']", "expect": { "fontSize": 24, "fontWeight": "300" } },
    "section-named": { "selector": "[data-role='practices-v2'] [data-kit='section-head'] [data-role='display-named']", "expect": { "fontWeight": "600" } },
