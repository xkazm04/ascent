// Ascent — Phase 2 persistence schema.
//
// DSQL-safe by design (works identically on local Postgres and Amazon Aurora DSQL):
//   - relationMode = "prisma"  -> NO foreign-key constraints emitted (DSQL doesn't
//     support FKs); relations are enforced at the Prisma layer. Requires manual
//     @@index on relation scalar fields (added below).
//   - UUID primary keys via @default(uuid())  -> no SERIAL / sequences (DSQL has none).
//   - Bulky string arrays are stored as serialized JSON in text columns (no jsonb
//     dependency); queryable fields (scores, level, timestamps) are real columns so
//     trend/history queries stay relational.
//
// On DSQL, create indexes asynchronously (CREATE INDEX ASYNC ...) — see
// docs/ARCHITECTURE.md. Migrations: Prisma is supported by DSQL (since 2026-02).

generator client {
  provider   = "prisma-client-js"
  // engineType = "client" selects Prisma's Rust-free query compiler (wasm) instead of the native
  // query_engine binary. Every client MUST be constructed with a driver adapter (see
  // src/lib/db/client.ts newClient()). This is the ONLY way Prisma runs on Windows-ARM64, where no
  // native windows-arm64 engine ships; it is identical in behavior on x64/Linux.
  engineType = "client"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Organization {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  name                  String
  plan                  String   @default("free") // free | pro | team | enterprise
  // Tenant flavor: "org" (a GitHub organization fleet) or "personal" (an individual's workspace,
  // slug = their GitHub login). A personal org holds watch-pointer Repository rows only — a public
  // repo's scan series stays in the shared "public" org (the personal dashboard is a lens over that
  // corpus, never a second copy). Stamped by the identity-bound personal-namespace claim in
  // src/lib/authz.ts; drives the personal nav subset and (later) personal-tier limits.
  kind                  String   @default("org") // org | personal
  // Prepaid private-scan credit balance. Public scans are free + unmetered; each private (installation)
  // scan that runs real LLM inference debits one credit (see src/lib/db/credits.ts + src/lib/entitlement.ts).
  // `enterprise` plan is treated as unlimited (no debit). Credits are granted out-of-band (a Polar
  // top-up, or an owner/admin grant) — see docs/BILLING.md. The CreditLedger is the audit trail.
  scanCredits           Int      @default(0)
  // Per-org data-retention overrides (enterprise). null = inherit the global env default
  // (RETENTION_MAX_SCANS_PER_REPO / RETENTION_AUDIT_DAYS); 0 = keep everything (unlimited).
  // Enforced by the /api/cron/purge job — see src/lib/db/retention.ts.
  retentionMaxScans     Int?
  retentionAuditDays    Int?
  // Per-org alert sink (Slack-compatible incoming webhook). Regression alerts, low-credit pushes and
  // the weekly digest route HERE when set, falling back to the global ALERT_WEBHOOK_URL env — so each
  // tenant receives its own fleet intelligence instead of everything landing in the operator's channel.
  // null = inherit the global sink (or a clean no-op when that's unset too). See src/lib/db/org-alerts.ts.
  alertWebhookUrl       String?
  // Per-org regression sensitivity (points). null = inherit DEFAULT_THRESHOLDS (overall 5 / dim 15).
  // Threaded into detectRegression by checkAndAlertRegression — see src/lib/scan-alerts.ts.
  alertOverallDrop      Int?
  alertDimensionDrop    Int?
  // Per-org CI maturity-gate policy (GatePolicy serialized as JSON in a TEXT column — the schema's
  // no-jsonb DSQL-safety contract; parsed at the edge in org-gate.ts). null = archetype default.
  // Honored by the App-mode PR Check Run + the governance fleet view — see src/lib/db/org-gate.ts.
  gatePolicy            String?
  // White-label branding for the executive briefing (EXEC-5, enterprise) — null = the Ascent default.
  // brandColor is a #rrggbb accent; logoUrl an https image rendered in the PDF header. See briefing.
  brandName             String?
  brandColor            String?
  logoUrl               String?
  // Canonical IANA time zone for THIS org's calendar-day math — window presets, custom-range parsing,
  // trend day-keys and due-date bucketing (see src/lib/org/timezone.ts, which was written parameterized
  // on an explicit `tz` for exactly this column). null = inherit the deployment-wide default
  // (ASCENT_ORG_TZ, else UTC), which is what every existing row does, so behavior is unchanged until an
  // org sets one. Validated against the runtime before use — an unknown zone degrades to the default
  // rather than throwing inside a dashboard render.
  timezone              String?
  // Low-balance ("auto-recharge") preference as JSON in a TEXT column — the schema's no-jsonb
  // DSQL-safety contract, mirroring `gatePolicy`. Shape: AutoRechargePref
  // { enabled, threshold, packProductId } (src/components/org/shared/CreditsControl.autorecharge.ts).
  // null = never set → DEFAULT_AUTO_RECHARGE (feature OFF). Previously the preference lived as the most
  // recent `billing.autorecharge` AuditLog row, which cost a findMany per read and put a user SETTING
  // inside the audit trail, where any retention/purge policy could silently erase it (G1-39). The audit
  // row is still written on every change — as an audit row. Read via src/lib/db/org-settings.ts.
  autoRechargeJson      String?
  // Revocation epoch for the org's OTel ingest token (src/lib/integrations/ingest-token.ts). Same
  // shape as SessionRevocation.version, per-org: the token embeds the epoch it was minted at
  // (`asc_otel.<slug>.e<N>.<mac>`, or the epoch-0 3-segment form), and the ingest guard rejects any
  // token whose epoch is BELOW this value. Bumping it kills a leaked token immediately without
  // rotating the server-wide INTEGRATIONS_INGEST_SECRET — which would silently re-derive every OTHER
  // org's token at the same time. 0 = never rotated, so existing tokens keep working.
  ingestTokenEpoch      Int      @default(0)
  // Per-repo `.ai/memory/` mirroring (moonshot #14). null = ON for org-owned repos (the default the
  // feature ships with); false = the org opted out and no repo-authored memory entry is indexed.
  // A Boolean?, not a Boolean @default(true): "never chosen" and "chosen ON" are different facts, and
  // only the former may be changed by a later product decision. NOTE the deliberate name split — this
  // SCALAR is `repoMemoryMirror`; the back-relation to the mirrored rows is `repoMemoryMirrors`.
  repoMemoryMirror      Boolean?
  // Per-org scan COMPACTION overrides (moonshot #32). null = inherit the env default
  // (RETENTION_COMPACT / RETENTION_DIGEST_MONTHS). retentionDigestMonths keeps the module's
  // 0-sentinel: 0 = keep digests forever. See src/lib/db/scan-digest.ts.
  retentionCompact      Boolean?
  retentionDigestMonths Int?
  githubInstallId       String?
  createdAt             DateTime @default(now())

  memberships         Membership[]
  repositories        Repository[]
  auditLogs           AuditLog[]
  alertEvents         AlertEvent[]
  subscription        Subscription?
  creditLedger        CreditLedger[]
  goals               Goal[]
  initiatives         Initiative[]
  segments            Segment[]
  playbooks           Playbook[]
  invites             Invite[]
  orgSkills           OrgSkill[]
  orgApiTokens        OrgApiToken[]
  orgMemories         OrgMemory[]
  orgDecisions        OrgDecision[]
  recOverlays         RecommendationOverlay[]
  sandboxScenarios    SandboxScenario[]
  program             TransitionProgram?
  techGroups          TechStackGroup[]
  llmConfig           OrgLlmConfig?
  loopRuns            LoopRun[]
  athenaThreads       AthenaThread[]
  athenaProposals     AthenaProposal[]
  athenaIdentity      AthenaIdentity[]
  // Named `repoMemoryMirrors` (plural) because the scalar opt-out flag above already owns the
  // singular `repoMemoryMirror`. A Prisma model cannot carry two fields of the same name, and the
  // FLAG is the one the product surface reads by name — so the relation is the one that pluralizes.
  repoMemoryMirrors   RepoMemoryMirror[]
  loopDrives          LoopDrive[]
  // MOONSHOT WAVE 3. ControlLedgerSeal is deliberately NOT here: a seal outlives the observations it
  // sealed (retention purges rows, never seals), so it is standalone like every other hand-cascaded
  // ledger in this schema and is removed only by the org-erase sweep in src/lib/db/retention.ts.
  scanJobs            ScanJob[]
  controlObservations ControlObservation[]
}

// A human decision on a DERIVED finding — the state layer that turns a read-only signal (a failing
// security check, a repo with no CODEOWNERS, a passport blocker, a solo-maintained repo) into an
// actionable item that can be closed. Those findings are recomputed from scan data on every render and
// own no row of their own, so before this model there was nowhere to record "we looked at this and
// decided". A rail badge is a promise that the number goes down when you act; this is what lets it.
//
// `itemKey` is the finding's DETERMINISTIC identity within its module (see src/lib/org/findings.ts) —
// e.g. "acme/api::branch-protection". It must be recomputed to the same string on the next scan, or the
// decision orphans and the finding silently reappears. Hence keys are built from stable ids (repo
// fullName, check id) and only fall back to hashing free text when nothing stable exists.
//
// A decision is an UPSERT on (orgId, module, itemKey) — re-deciding an item edits its row rather than
// appending, and `status: "open"` means "reopened", not "never touched" (an undecided finding has NO
// row at all, which is what keeps this table sparse). `memoryId` points at the OrgMemory row written
// through on each decision, so the rationale reaches connected agents and the scan prompt.
model OrgDecision {
  id           String    @id @default(uuid())
  orgId        String
  module       String // security | teams | passports | contributors
  itemKey      String // deterministic identity of the finding within (orgId, module)
  status       String    @default("open") // open | accepted | dismissed | snoozed
  rationale    String    @default("") // why — the payload agents actually learn from
  title        String    @default("") // the finding's human title at decision time (survives its disappearance)
  decidedBy    String? // GitHub login
  memoryId     String? // the OrgMemory row this decision wrote through to
  snoozedUntil DateTime? // set when status = snoozed; the item re-enters the badge after this
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, module, itemKey])
  @@index([orgId, status])
  @@index([orgId, module])
}

// Append-only ledger of scan-credit movements — the trustworthy record behind Organization.scanCredits.
// One row per grant (+) or per-scan debit (-), each stamping the resulting balance so the running total
// can be audited and reconciled against billing top-ups (Polar). Standalone under relationMode="prisma"
// (no DB FKs); always queried by orgId. See src/lib/db/credits.ts.
model CreditLedger {
  id           String   @id @default(uuid())
  orgId        String
  delta        Int // +N granted, -N debited
  balanceAfter Int // org.scanCredits immediately after applying this row (within the same txn)
  reason       String   @default("scan") // scan | grant | polar | adjustment | refund
  repoFullName String? // the repo a scan debit paid for (null for grants/adjustments)
  scanId       String? // the Scan row a debit paid for, when known
  actor        String? // GitHub login (grant/adjustment) or the billing provider ("polar"/"system")
  // Idempotency key for externally-fulfilled grants — the Polar order id, prefixed "polar:". UNIQUE so a
  // webhook redelivery can't double-grant: grantCredits short-circuits when a row with this id exists,
  // and a racing duplicate insert hits this constraint and rolls back. Null for scans/manual grants.
  // See src/app/api/billing/webhook/route.ts.
  externalId   String?  @unique
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([orgId, createdAt])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  // GitHub login — the identity the session actually carries (auth is GitHub-OAuth/App based, not
  // email/password). Bridges a session to a Membership row so RBAC (Membership.role) can be resolved
  // and persisted for the logins we know. Email is kept (unique, required) and set to the GitHub
  // noreply form for App/OAuth users. See src/lib/db/members.ts.
  githubLogin String?  @unique
  name        String?
  createdAt   DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id                    String    @id @default(uuid())
  orgId                 String
  userId                String
  role                  String    @default("member") // owner | admin | member | viewer
  createdAt             DateTime  @default(now())
  // Per-user-per-org "last looked at the fleet" watermark — the read state behind the Alerts chip's
  // movement count ("what moved since you last looked"). Nullable: a member who has never opened the
  // control has no watermark, and the movement window falls back to `createdAt` (since you joined)
  // rather than replaying the org's whole history. Advanced by POST /api/org/alerts { seen: true }.
  alertsSeenAt          DateTime?
  // Org-scoped onboarding stamp (W6a). The getting-started gate is a STAMP, not an empty-data
  // heuristic: either timestamp, once set, silences the guided onboarding flow for THIS member in
  // THIS org forever (the kp pattern). Two nullable columns rather than one enum so "finished it"
  // and "dismissed it" stay distinguishable. Written ONLY by the member's own
  // POST /api/org/onboarding (self-stamp, exactly like alertsSeenAt above). Step DONENESS is never
  // stored per step — it is derived from real data at read time (src/lib/org/getting-started.ts),
  // so doing the work through any door completes a step and the checklist can't drift.
  // The add-column migration backfills every EXISTING row as completed (stamped with the migration
  // date) so no live org/dev DB gets ambushed — only memberships created after W6a start null.
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// A pending invitation to join an org at a given role. Bridges the gap before MEM-2: the only
// "add member" path was an owner typing an exact GitHub login into setMembershipRole (a typo
// silently created a ghost membership). An invite carries a single-use `token` (the capability in
// the /invite/[token] link), optionally pins a githubLogin/email, expires, and is consumed by
// acceptInvite → setMembershipRole. See src/lib/db/invites.ts.
model Invite {
  id          String   @id @default(uuid())
  orgId       String
  email       String?
  githubLogin String? // when set, only this login may accept (case-insensitive)
  role        String   @default("member") // owner | admin | member | viewer
  token       String   @unique
  status      String   @default("pending") // pending | accepted | revoked
  invitedBy   String? // GitHub login of the owner who created it
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([status])
}

model Repository {
  id                    String    @id @default(uuid())
  orgId                 String
  owner                 String
  name                  String
  fullName              String // "owner/name"
  url                   String
  isPrivate             Boolean   @default(false)
  primaryLanguage       String?
  // Latest detected tech stack (Feature 3a), cached from the most recent scan for fleet-wide grouping
  // without re-deriving. JSON TechStack (see src/lib/analyze/tech-extract.ts). Null until first scan.
  techStackJson         String?
  // Latest App Readiness Passport (JSON AppPassport) cached from the most recent scan — the portfolio
  // scorecard surfaced/compared without re-deriving. Display-only. Null until first scan.
  passportJson          String?
  // Owner-set passport overrides (P4) for the fields a scan can't observe — JSON
  // { criticality?, lifecycle?, rollback? }. Applied as a read-time overlay over the scan-derived
  // passport (never mutates the stored scan). Null = none set. See src/lib/db/passport-overrides.ts.
  passportOverridesJson String?
  // Latest Context Health (JSON ContextHealth — guidance-file freshness, quality, drift) cached from
  // the most recent scan, mirroring techStackJson/passportJson. Display-only (never scored). Null
  // until the first post-W4 scan — the UI reads null as "not assessed by this scan", never as absent.
  contextHealthJson     String?
  stars                 Int       @default(0)
  // Current default-branch head + the GitHub ETag from the last conditional HEAD lookup.
  // Together these back the cross-instance scan cache: a re-scan sends `If-None-Match: headEtag`
  // (a free 304 when unchanged) and serves the persisted scan pinned to headSha — see
  // src/lib/scan-cache.ts. Null until the repo's first anonymous scan records them.
  headSha               String?
  headEtag              String?
  watched               Boolean   @default(false)
  // LOCAL MODE (self-hosted only): absolute path of this repo's working copy on the SERVER's
  // filesystem — the pairing that lets scans ingest from disk (git ls-files/log, no GitHub round
  // trip) and lets the autopilot dispatch a local coding agent into the checkout. Null = unpaired.
  // Written only by the Admin → Pairing tab (self-host-gated routes); meaningless on Ascent Cloud.
  // Under Docker this is a path INSIDE the container — the operator mounts their code as a volume.
  localPath             String?
  scanSchedule          String    @default("off") // off | daily | weekly | monthly
  lastScanAt            DateTime?
  nextScanAt            DateTime?
  // The INTENDED autoscan slot — the cadence anchor, deliberately separate from `nextScanAt`.
  // `nextScanAt` is dual-purpose: it is both the schedule AND the claim LEASE (claimRescan overwrites it
  // with now+15min before the scan runs, advanceScheduleAfterFailure with now+6h), so by the time
  // advanceToFullCadence settles a repo the intended slot is already gone and the next one was computed
  // from Date.now() — every run's queue latency accumulated and "daily"/"weekly" drifted later forever
  // (G3-13). This column is written ONLY by the cadence-setting paths, never by a lease, so settling
  // anchors on the slot that was actually intended. null = legacy/never-scheduled row: the settle falls
  // back to now-anchoring (today's exact behavior) and stamps the anchor for the next cycle. See
  // nextSlotFrom in src/lib/db/org-watch.ts.
  scanSlotAt            DateTime?
  // Outcome of the most recent scan ATTEMPT (bulk/cron), so the dashboard can tell "never scanned"
  // apart from "scanning is broken" (revoked token, deleted repo, rate-limited). Null until first try.
  lastScanStatus        String? // "ok" | "error"
  lastScanError         String?
  lastScanAttemptAt     DateTime?
  // `.ai/` standard conformance reported back by the repo's doctor (`node .ai/doctor.mjs --json`),
  // closing the adopt→verify→re-score loop. Null until a conformance report lands. See
  // src/app/api/report/conformance + src/lib/standard/doctor.ts.
  aiConformance         Int? // 0..100 conformance %
  aiConformanceFails    Int?
  aiConformanceWarns    Int?
  aiConformanceAt       DateTime?
  // First time a SUCCESSFUL, COMPLETE org listing came back WITHOUT this repo — i.e. it was renamed,
  // transferred, deleted, or turned private on GitHub. A flag only: reconciliation NEVER unwatches
  // (a temporarily-unlistable repo must not be silently dropped), and the stamp is cleared the moment
  // the repo reappears in a listing. Cleanup is an explicit user action on the repositories tab.
  // See reconcileListedRepos in src/lib/db/org-watch.ts.
  missingSince          DateTime?
  // What this repo IS to the org. "fleet" = a product repo the maturity math grades; "registry" = the
  // org's shared-primitive repo (UC2), excluded from fleet scoring and rollups because grading the
  // library against product-delivery dimensions is meaningless. Defaulted, so every existing row is fleet.
  role                  String    @default("fleet") // fleet | registry
  // Latest `.ai/manifest.yaml` readout (JSON ManifestReadout) cached from the most recent scan,
  // mirroring techStackJson/passportJson (moonshot #13). DECLARED capability, never proven and never
  // scored — the Passports capability matrix reads it beside the observed signals. Null until a scan
  // fetches a manifest; null must render as "no manifest declared", never as "declares nothing".
  manifestJson          String?
  // Latest guidance graph (JSON GuidanceGraph — which agent-guidance files exist, which one governs
  // a path, and where two of them contradict each other) cached from the most recent scan, mirroring
  // contextHealthJson (moonshot #15). Display-only, never scored. Null = no scan has assessed this
  // repo's guidance yet, which is NOT "the repo has no guidance" and NEVER a zero.
  guidanceGraphJson     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org          Organization           @relation(fields: [orgId], references: [id])
  scans        Scan[]
  digests      ScanDigest[]
  contributors RepoContributor[]
  teams        RepoTeam[]
  aiChanges    AiChange[]
  deployments  Deployment[]
  segments     RepoSegment[]
  techGroups   TechStackGroupMember[]

  @@unique([orgId, fullName])
  @@index([orgId])
  @@index([fullName])
  @@index([watched])
}

// A user-defined slice of the fleet — a named tag grouping repos (e.g. "platform", "mobile",
// "legacy", "acquisitions"). Repos are tagged via RepoSegment (many-to-many), so a repo can belong
// to several segments. Every org aggregate (getOrgRollup/Movers/GapAnalysis/Recommendations/
// Contributors) accepts an optional segment filter that scopes it to the tagged repos, and two
// segments can be compared side by side. Org-scoped and uniquely named within an org.
// See src/lib/db/segments.ts.
model Segment {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  color     String   @default("#3b9eff") // accent hex for the chip
  createdAt DateTime @default(now())

  org   Organization  @relation(fields: [orgId], references: [id])
  repos RepoSegment[]

  @@unique([orgId, name])
  @@index([orgId])
}

// Membership of a repo in a segment — the tag join. Toggled per (segment, repo). Standalone under
// relationMode="prisma" (no DB FKs); deleting a segment cascades its rows at the Prisma layer.
model RepoSegment {
  id        String   @id @default(uuid())
  segmentId String
  repoId    String
  createdAt DateTime @default(now())

  segment Segment    @relation(fields: [segmentId], references: [id])
  repo    Repository @relation(fields: [repoId], references: [id])

  @@unique([segmentId, repoId])
  @@index([segmentId])
  @@index([repoId])
}

model RepoContributor {
  id           String    @id @default(uuid())
  repoId       String
  login        String
  name         String?
  commits      Int       @default(0)
  aiCommits    Int       @default(0)
  lastActiveAt DateTime?
  updatedAt    DateTime  @updatedAt

  repo Repository @relation(fields: [repoId], references: [id])

  @@unique([repoId, login])
  @@index([repoId])
}

// One AI-attributed pull request, as an EVIDENCE ROW rather than an aggregate.
//
// Why this exists: `Scan.prStats` stores rates (aiInvolvedRate, aiGovernedRate) computed in a loop and
// then thrown away, so ascent could say "62% of AI PRs were approved" but could never answer the only
// question an auditor actually asks — "show me the population of AI-assisted changes in the period, let
// me sample it, and evidence the review control for each sampled item." A percentage is not evidence;
// the row is. This table is the population.
//
// It costs nothing extra to collect: fetchPullRequests already pages these PR nodes over GraphQL for
// the rate math and discards them. The only added field on the wire is the review author's login.
//
// PRIVACY: `authorLogin` / `approverLogin` are real GitHub logins (public on the PR itself, but durable
// and exportable here). The customer-facing pack pseudonymizes them unless the org opts into named
// evidence; the raw logins stay internal so a sample can be re-verified against GitHub. Rows age out
// under the org's normal retention window like every other scan artifact.
model AiChange {
  id                 String    @id @default(uuid())
  repoId             String
  orgId              String // denormalized so the org-wide population is one query, not a join per repo
  prNumber           Int
  title              String
  authorLogin        String? // null for a deleted GitHub account
  authorIsBot        Boolean   @default(false) // agent-authored (Copilot/Devin/…) vs a human using AI
  // How this PR was identified as AI-involved: "authored" (an AI agent opened it) or "marked" (an AI
  // marker in the title/body/labels — a human using a tool). Kept because the two carry very different
  // governance weight and an auditor will ask which one a sampled row was.
  aiSignal           String
  /**
   * Tools named in the PR, comma-separated (from the same taxonomy prStats counts).
   */
  aiTools            String    @default("")
  state              String // OPEN | CLOSED | MERGED
  mergedAt           DateTime?
  // THE CONTROL: was this AI-attributed change approved by a human before merge, and by whom.
  // `approved=false` with `approverLogin=null` is the finding an auditor is looking for.
  approved           Boolean   @default(false)
  approverLogin      String?
  approvedAt         DateTime?
  /**
   * Reviews submitted on the PR (any state) — distinguishes "unreviewed" from "reviewed, not approved".
   */
  reviewCount        Int       @default(0)
  // W5 revert linkage: the merged revert PR that rolled this AI change back, matched within the
  // scanned PR window (title `Revert "<original title>"` / message `This reverts commit <sha>`).
  // A LOWER BOUND — null means "no revert matched in the window", never "was never reverted".
  revertedByPr       Int?
  revertedAt         DateTime?
  // W4: the PR's merge-commit SHA, lower-cased. Already on the wire — the revert linkage has paged
  // `mergeCommit.oid` since W5 and discarded it — so persisting it costs no extra API call.
  //
  // It exists to make deployment attribution an EQUALITY rather than a guess: a GitHub deployment
  // names the sha it shipped, so `Deployment.sha == AiChange.mergeCommitSha` identifies exactly which
  // change a deployment carried. The alternative — "the PR that merged closest before the deploy" —
  // is a time-window heuristic, and it would sit underneath the most quotable number this product
  // can produce ("AI-authored changes fail at X%"). A wrong attribution there is not a rounding
  // error, it is the whole claim. Null on pre-W4 rows and on unmerged PRs.
  mergeCommitSha     String?
  // MOONSHOT #1 — how this row reached us. "scan" is the historical path (a PR window paged at scan
  // time) and stays the default so every pre-existing row keeps its true provenance; "webhook" rows
  // arrive from the live event stream between scans. The two are NOT interchangeable evidence: a scan
  // row was observed at a scan's cadence, a webhook row within seconds of the event.
  source             String    @default("scan") // scan | webhook
  // MOONSHOT #1 — when the approval was OBSERVED, which is the webhook's delivery time and NOT
  // `approvedAt` (the review's own submission time, as GitHub reports it). Null on scan-sourced rows:
  // a scan learns of an approval at an unknowable delay, and stamping the scan's clock here would
  // dress a cadence artifact up as an observation time. Null is "not observed live", never "not
  // approved" — `approved` is the field that answers that.
  approvalObservedAt DateTime?
  createdAt          DateTime // the PR's own creation time, not the row's
  recordedAt         DateTime  @default(now())

  repo Repository @relation(fields: [repoId], references: [id])

  // A PR is one change: re-ingesting the same window must UPDATE the row (its state/approval can move
  // between scans), never append a duplicate that would double-count the population.
  @@unique([repoId, prNumber])
  @@index([orgId, createdAt])
  @@index([orgId, approved])
  // W4: the deployment→change join reads by sha within an org.
  @@index([orgId, mergeCommitSha])
}

// One deployment, as GitHub's Deployments API reported it (W4) — the event that anchors "failure" to
// something outside git.
//
// WHY THIS IS THE OUTCOME SOURCE. Ascent could already say a change was reverted (a git fact), but
// not whether it BROKE anything. DORA's change-failure rate needs a deployment to have happened and
// to have succeeded or not, and GitHub's Deployments API reports exactly that — for free, through
// the installation token the scan already holds. No new vendor, no new auth surface.
//
// WHAT IT IS AND IS NOT. `state` is the deployment's own latest status, so "failure" means THE
// DEPLOYMENT FAILED — not "this change caused an incident". Those are different claims and only the
// first is observable here; every surface that renders this must say so. MTTR is likewise derived as
// "time to the next successful deployment in the same environment", which is a proxy for restore
// time and is labelled as one.
model Deployment {
  id          String    @id @default(uuid())
  repoId      String
  orgId       String // denormalized so the org-wide read is one query
  // GitHub's own deployment id, so re-ingesting a window updates rather than appends.
  externalId  String
  environment String // "production" | "staging" | … as the repo names them
  sha         String // lower-cased; the join key to AiChange.mergeCommitSha
  ref         String?
  // Latest status from the deployment's status list: success | failure | error | inactive |
  // in_progress | queued | pending. A deployment with NO status is stored with "pending" rather than
  // being dropped — it happened, we just do not know how it ended.
  state       String
  createdAt   DateTime // the deployment's own creation time
  statusAt    DateTime? // when the latest status was recorded — the clock MTTR is measured on
  recordedAt  DateTime  @default(now())

  repo Repository @relation(fields: [repoId], references: [id])

  @@unique([repoId, externalId])
  @@index([orgId, createdAt])
  @@index([orgId, sha])
}

// A team that owns part of a repo, parsed from its CODEOWNERS file at scan time. The unit behind
// the org's team-level rollups (getOrgTeamRollup): a repo is attributed to every team in its
// CODEOWNERS, so Adoption×Rigor, gaps, movers, and AI-knowledge can aggregate per team. The latest
// scan is authoritative — persistScanReport replaces a repo's full RepoTeam set each scan, so a
// removed/renamed team can't linger. `slug` is the normalized "@org/team" mention (lowercased).
model RepoTeam {
  id             String   @id @default(uuid())
  repoId         String
  slug           String // normalized "@org/team" code-owner mention (lowercased)
  ownedPaths     Int      @default(0) // # of CODEOWNERS rules that name this team
  isDefaultOwner Boolean  @default(false) // owns the "*" catch-all rule (the repo's primary owner)
  source         String   @default("codeowners") // codeowners | github_teams
  updatedAt      DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id])

  @@unique([repoId, slug])
  @@index([repoId])
}

model Scan {
  id                  String   @id @default(uuid())
  repoId              String
  headSha             String? // the commit the scan pinned to — powers /report/{owner}/{repo}@{sha} permalinks
  // CROSS-INSTANCE idempotency key for SHA-LESS scans (G3-01). `@@unique([repoId, headSha])` is the
  // cross-instance dedup backstop for a scan pinned to a commit, but Postgres treats NULLs as distinct,
  // so it never engages when headSha is NULL — two concurrent instances persisting the same sha-less
  // report both passed the read-then-insert dedup and both inserted a metered row. This column carries
  // the report's own IDENTITY (scannedAt + the content key: score/level/axes/engine + per-dimension
  // scores — see scanDedupKey in src/lib/db/scans-read.ts), so the SAME computed report can only exist
  // once per repo no matter which instance wrote it, and the loser fails with P2002 and re-reads the
  // winner (the identical recovery the sha path already has).
  //
  // SET ONLY ON SHA-LESS ROWS. A scan with a headSha leaves this NULL and stays governed by the
  // (repoId, headSha) constraint — one dedup identity per row, never two competing ones. NULLs being
  // distinct is what makes that (and the un-backfilled legacy rows) safe under the unique index.
  dedupKey            String?
  overallScore        Int
  level               String // "L1".."L5"
  levelName           String
  archetype           String   @default("org")
  adoptionScore       Int      @default(0)
  rigorScore          Int      @default(0)
  posture             String   @default("")
  confidence          Float    @default(0)
  engineProvider      String
  engineModel         String
  headline            String
  strengths           String   @default("[]") // JSON string[]
  risks               String   @default("[]") // JSON string[]
  // LLM-as-auditor output: suspected deterministic-detector misses, persisted so the
  // detector backlog (getOrgDiscrepancies) can aggregate them across the fleet. JSON Discrepancy[].
  discrepancies       String   @default("[]")
  prStats             String? // JSON PrStats (pull-request process signals); null if no token
  // W6 — the repo's PRACTICE SHAPE: the heading outlines and path layouts of its guidance, PR
  // template, ADRs and harness. STRUCTURE ONLY, never a body (see analyze/practice-shape.ts). It is
  // what lets the org mine its OWN house pattern instead of shipping the same nine generic starters
  // to every customer. Display/reuse-only — never scored, never on a public surface.
  practiceShape       String?
  governance          String? // JSON Governance (branch protection / rulesets); null if no token
  commitActivity      String? // JSON number[] — last ~12 weekly commit totals; null if no token
  // Per-scan detected tech stack (Feature 3a) — JSON TechStack. Keeps history honest when a repo
  // re-stacks; the latest is also cached on Repository.techStackJson. Display-only (never scored).
  techStackJson       String?
  // Per-scan App Readiness Passport — JSON AppPassport. Per-scan history; latest cached on
  // Repository.passportJson. Display-only (never scored). See src/lib/analyze/passport.ts.
  passportJson        String?
  // Per-scan Context Health (W4) — JSON ContextHealth: per-guidance-file last-modified + size +
  // quality, approximate commits-since-edit staleness, and dead @file-reference drift. Latest cached
  // on Repository.contextHealthJson. Display-only (never scored). See src/lib/analyze/context-health.ts.
  contextHealthJson   String?
  // Non-fatal scan caveats (JSON string[]): degrade-to-mock, low-coverage, truncated, no-token, and
  // stack-fit warnings. Persisted so a reloaded/permalinked scan keeps its reliability disclosure
  // instead of silently reading as a confident full scan (reference-scan P1-5). null = none.
  warningsJson        String?
  // Per-scan AI-usage indicator (JSON AiUsage: detected + PR-level signals + tool attribution). Persisted
  // so a reloaded report reproduces the fresh scan's detection instead of a lossy re-derivation from
  // contributors (the tree/commits that back guidance-file detection aren't stored). reference-scan P2/aiUsage.
  aiUsageJson         String?
  // Scoring rubric version (SCORING_RUBRIC_VERSION, src/lib/maturity/model.ts) active when this scan was
  // scored. Persisted per-row so the cross-instance DB cache tier can self-invalidate on a rubric bump
  // (persistedMatchesActiveIdentity) instead of serving a stale-rubric score until the 7-day age gate.
  // Nullable: rows scored before this column keep today's behavior (served, age-gated) — never force-rescanned.
  rubricVersion       String?
  // WHOSE account this scan's inference ran in: true = the org's OWN connected provider (BYOM),
  // false = Ascent's platform account. Read back onto engine.byom so the report header can say
  // "in YOUR AWS account" only when that is literally true. Nullable: rows scored before this column
  // are UNKNOWN, and unknown must render as the platform wording — never as the customer's account.
  engineByom          Boolean?
  // An LLM WAS requested for this scan and every real attempt failed, so `engineProvider` is the
  // deterministic mock FLOOR rather than a chosen engine (src/lib/scan.ts, `llmFailed`). Distinct from
  // engineProvider = "mock" on its own, which also covers a keyless deploy and an explicit demo — two
  // situations that are not failures. The loop's attribution rule reads it: a delta between a mock scan
  // and a real one measures the engine swap, not the repository, and must never be reported as a lift.
  // Nullable: rows written before this column are UNKNOWN, and unknown is not "not degraded".
  engineDegraded      Boolean?
  // The scoring-integrity record for this scan (JSON ScoreIntegrity — d9Unmeasurable, widenedDims,
  // widenCapped, effectiveBlend). It was computed, typed and rendered by nothing (UAT SAM-L1-02,
  // 2026-08-10) and, worse, not persisted at all — so a reconstructed report and every run-over-run
  // comparison lost the record of the three levers that move a headline on an UNCHANGED commit. Any
  // consumer comparing two scans has to be able to read it to attribute a delta. Null on legacy rows.
  scoreIntegrityJson  String?
  // WHAT THIS SCAN COULD SEE OF GITHUB (JSON PlatformSignalRecord — source, observedAt, fromScanId,
  // stale, per-dimension folds). The platform folds (analyze/platform-signals.ts) credit D2/D3/D4 for
  // tooling that is installed rather than committed, and a worktree scan cannot observe any of it. Left
  // unrecorded, the loop's own rescans scored those three dimensions at a floor the repository could
  // not raise, while `green` demanded L5 on every one of them — a ceiling with no visible cause. This
  // column is what lets a local rescan REPLAY the last observed fold (with its age) and, when there is
  // none, say the dimensions were not measurable instead of scoring them as failed.
  // Null on legacy rows and on any scan that never asked the question: UNKNOWN, which is deliberately
  // not the same value as "unavailable" — that one removes dimensions from a verdict.
  platformSignalsJson String?
  // LLM cost/usage metering: tokens consumed + the LLM-stage latency for this scan's model call.
  // Null on a mock/keyless scan (no model cost) or a provider that didn't report usage.
  inputTokens         Int?
  outputTokens        Int?
  llmLatencyMs        Int?
  // Per-scan `.ai/manifest.yaml` readout — JSON ManifestReadout (moonshot #13). Per-scan history of
  // what the repo DECLARED, so a later scan can show a capability that was claimed and then dropped;
  // the latest is cached on Repository.manifestJson. Display-only — never scored (G5). Null = this
  // scan fetched no manifest (no file, or a pre-#13 scan), which is NOT "declared nothing".
  manifestJson        String?
  // Per-scan guidance graph — JSON GuidanceGraph (moonshot #15): the arbitrated view of a repo's
  // agent-guidance files (CLAUDE.md, AGENTS.md, .cursor/rules, …) — which file governs which path,
  // which are stale, and where two contradict. Per-scan history so a later scan can show a
  // contradiction that was introduced and then resolved; the latest is cached on
  // Repository.guidanceGraphJson. Display-only — never scored. Null = a pre-#15 scan.
  guidanceGraphJson   String?
  scannedAt           DateTime
  createdAt           DateTime @default(now())

  repo            Repository       @relation(fields: [repoId], references: [id])
  dimensions      ScanDimension[]
  recommendations Recommendation[]

  // Cross-instance dedup backstop: two serverless instances persisting the SAME commit concurrently
  // both miss the read-then-insert dedup (the row isn't committed yet) and both insert. A unique
  // constraint makes the loser fail with P2002 (handled in persistScanReport → deduped). headSha is
  // nullable, so sha-less scans (NULLs are distinct in Postgres) are unconstrained and fall back to
  // the scannedAt dedup. Replaces the plain @@index (a unique index also serves the lookup).
  @@unique([repoId, headSha])
  // The SHA-LESS half of the same backstop (G3-01). Same mechanism, different identity: a sha-less scan
  // carries `dedupKey` (scannedAt + content) instead of a commit, so a concurrent duplicate loses with
  // P2002 and is recovered by findScanByDedupKey. NULL on every sha-bearing and every pre-migration row,
  // and NULLs are distinct, so this constrains nothing that existed before it.
  @@unique([repoId, dedupKey])
  @@index([repoId])
  @@index([repoId, scannedAt])
  // The ORG-ROLLUP index (G4-17). getOrgRollup / the trend + baseline queries filter Scan by the org's
  // whole repo set over a `scannedAt` window; every other index here LEADS on repoId, so none supports a
  // range scan over the window — latency scaled with the fleet's total scan-row count instead of the
  // window. A `scannedAt`-leading index gives the planner the range as the driving access path.
  // Deliberately NOT the "denormalize orgId onto Scan" alternative the finding also lists: that needs a
  // full backfill UPDATE over every existing Scan row (and a dual-write), which is exactly the kind of
  // non-additive, populated-DB-hostile change this batch is required to avoid.
  @@index([scannedAt])
}

model ScanDimension {
  id          String @id @default(uuid())
  scanId      String
  dimId       String // "D1".."D9"
  name        String
  weight      Float
  score       Int
  signalScore Int
  llmScore    Int
  summary     String @default("")
  evidence    String @default("[]") // JSON string[]
  strengths   String @default("[]") // JSON string[]
  gaps        String @default("[]") // JSON string[]

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([scanId])
}

model Recommendation {
  id            String    @id @default(uuid())
  scanId        String
  title         String
  dimId         String
  impact        String // high | medium | low
  effort        String // high | medium | low
  rationale     String    @default("")
  explore       String    @default("[]") // JSON string[] — invitational questions to explore the gap
  levelUnlock   String?
  status        String    @default("open") // open | in_progress | done | dismissed
  // r10 (2026-08-26): `gap` is a shortfall below the band — a follow-up the loop may work. `craft` is
  // what would make an already-strong dimension exemplary: shown on the report, never a follow-up,
  // never debt, never a loop batch, never auto-closed. The backlog and the loop read `kind: "gap"`.
  kind          String    @default("gap") // gap | craft
  // Ownership + planning layer that turns a scattered list of gaps into a trackable backlog
  // (the assignee/due-date mechanics behind the org-wide backlog view — see getOrgBacklog).
  // Both carry forward across re-scans (matched by dimId+title) so a re-scan doesn't drop who
  // owns a gap or when it's due. null = unassigned / no deadline.
  assigneeLogin String? // GitHub login accountable for closing this gap
  targetDate    DateTime? // optional due date the backlog is paced against
  createdAt     DateTime  @default(now())

  scan   Scan                  @relation(fields: [scanId], references: [id])
  events RecommendationEvent[]

  @@index([scanId])
  @@index([status])
  @@index([assigneeLogin])
}

// Append-only activity timeline for a recommendation — one row per status change, (re)assignment,
// or due-date change, capturing who did it (actor), what changed (kind, from → to), and an optional
// note. This is what makes the backlog trustworthy for planning the way Linear/Jira are: a complete,
// ordered audit of how a gap moved from open to done and who owned it along the way. Written in the
// same transaction as the mutation that caused it (see updateRecommendation). Standalone under
// relationMode = "prisma" (no DB FKs); always queried by recommendationId.
model RecommendationEvent {
  id               String   @id @default(uuid())
  recommendationId String
  actor            String? // GitHub login who made the change (null = system / anonymous)
  kind             String   @default("status") // status | assignee | target_date
  fromValue        String? // prior value (status id, login, or ISO date) — null when first set
  toValue          String? // new value — null when cleared
  note             String? // optional free-text note attached to the change
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id])

  @@index([recommendationId])
  @@index([createdAt])
}

// A PERSONAL-workspace overlay on a shared public-corpus recommendation (individual tier, decision 3).
// Public-repo recommendations live on scans in the shared "public" org, where their status/assignee
// columns are a SHARED surface — an individual tracking someone else's repo must not mutate them.
// This row is one viewer's private standing on one recommendation, keyed by the personal org plus the
// recommendation's STABLE identity (repoFullName + dimId + title — the same match key
// matchRecommendations uses to carry status across re-scans), NOT the scan-bound Recommendation.id,
// so an overlay survives every re-scan without pointing at a dead row. Sparse: no row = untouched
// ("open"). Upsert on the unique; reads join at render time (see src/lib/db/personal-backlog.ts).
model RecommendationOverlay {
  id           String    @id @default(uuid())
  orgId        String // the PERSONAL org (the viewer's workspace) — the tenant scope
  repoFullName String // "owner/name" in the shared public corpus
  dimId        String
  title        String
  status       String    @default("open") // RecStatus: open | in_progress | done | dismissed
  targetDate   DateTime? // personal due date (null = open-ended)
  note         String    @default("") // private context; feeds the Phase-3 decisions/memory loop
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, repoFullName, dimId, title])
  @@index([orgId, repoFullName])
}

model AuditLog {
  id      String   @id @default(uuid())
  orgId   String?
  actorId String?
  action  String
  meta    String   @default("{}") // JSON object
  at      DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([at])
  // Serves the org-scoped audit viewer's keyset query (where orgId, order by at desc, id desc).
  @@index([orgId, at])
}

// One row per alert the product DECIDED to raise — deliberately NOT AuditLog: audit claim rows are
// deleted on dispatch failure (releaseAuditClaim) and the whole trail is purged by
// retentionAuditDays, so neither "what did we try to send" nor "what failed" survives there. This
// table is the in-app alert history: rows are written even when NO sink is configured
// (delivered=false, suppressedReason="no-sink") — without that, every alert except scan.regression
// vanished without a trace on webhook-less orgs.
model AlertEvent {
  id               String   @id @default(uuid())
  orgId            String
  /**
   * regression | promotion | security | low-credits | digest | goal-at-risk | spend-anomaly
   */
  kind             String
  /**
   * info | warning | critical | celebration
   */
  severity         String
  repoFullName     String?
  title            String
  /**
   * The plain-text body the sink got (or would have gotten).
   */
  body             String   @default("")
  delivered        Boolean  @default(false)
  /**
   * webhook | email | null (no sink resolved).
   */
  sinkKind         String?
  /**
   * Why nothing was sent: no-sink | cooldown | dispatch-failed. Null when delivered.
   */
  suppressedReason String?
  createdAt        DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  // Serves the history drawer's keyset query (where orgId, order by createdAt desc).
  @@index([orgId, createdAt])
}

model Subscription {
  id        String   @id @default(uuid())
  orgId     String   @unique
  stripeId  String?
  status    String   @default("inactive")
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])
}

// A maturity target an org is steering toward — the management layer over the trend/forecast.
// `metric` is "overall" | "adoption" | "rigor" | a dimension id ("D1".."D9"); progress is derived
// from the fleet's latest scans at read time (no stored snapshot to drift). `targetDate` is the
// optional deadline the goal is paced against — the trend slope projects an ETA that's compared to
// it to read "on pace / behind / reached". See src/lib/db/plan.ts.
model Goal {
  id         String    @id @default(uuid())
  orgId      String
  label      String
  metric     String    @default("overall")
  target     Int       @default(50)
  targetDate DateTime? // optional deadline the goal is paced against (null = open-ended)
  status     String    @default("active") // active | achieved | archived
  achievedAt DateTime? // when the goal first reached its target (set once by listGoals); null = not met
  createdAt  DateTime  @default(now())

  // The metric's fleet value AT CREATION — the only thing that makes the goal meter a PROGRESS bar
  // instead of an attainment ratio. Without it `pct` can only be current/target, so a goal set at 70
  // while the fleet sits at 63 renders 90%-full on day one and barely moves as the work happens.
  // The value is not recoverable after the fact (the fleet's history is per-repo scans, and picking
  // an "earliest available scan" would invent a number and could make an in-flight goal read as
  // regressed), which is why it is stored rather than derived.
  // NULLABLE ON PURPOSE, and never backfilled: null means "created before baselines existed" (or on a
  // scan-less fleet, where every metric reads 0 and a stored 0 would be a fabricated measurement).
  // listGoals renders those goals as attainment, LABELLED as attainment — an honest old number beats
  // a plausible new one. See GoalProgress.pct in src/lib/db/plan.ts.
  baselineValue Int? // 0..100 metric value when the goal was created; null = no baseline on record
  baselineAt    DateTime? // when that baseline was captured (== createdAt for goals that have one)

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// One coding-agent SESSION, as an ATTEMPT rather than a day-bucketed total (W3a).
//
// `AiUsageRecord` answers "what did this repo's AI cost last Tuesday". It cannot answer the question
// Port's AI-SDLC research says every org gets wrong — what does a UNIT OF WORK cost — because a day
// bucket has no notion of an attempt. This table is the attempt.
//
// WHAT IS MEASURED HERE IS ONLY WHAT THE AGENT ITSELF REPORTS. Claude Code's OTel exporter emits
// per-session counters (`claude_code.commit.count`, `.pull_request.count`, `.lines_of_code.count`,
// tokens, cost) keyed by a `session.id` resource attribute. Those are facts. What is deliberately
// NOT stored is any guess about WHICH pull request a session produced: the telemetry carries no PR
// number, so linking a session to an `AiChange` row would mean matching on repo + time window, and a
// heuristic join wearing a precise number's clothes is the exact defect `docs/VALUE-CASE.md` D32
// exists to prevent. The join to merged changes is therefore made at REPO × PERIOD level, where both
// sides are counted rather than guessed (see src/lib/db/agent-sessions.ts).
//
// NO `outcome` ENUM, ON PURPOSE. A session that produced no commit is very often a question, a code
// read, or a debugging pass — calling it "abandoned" or "failed" would be an over-claim about the
// most common kind of session there is. The counts are stored and the derived reads say exactly what
// they mean: "sessions that produced code" vs "sessions that did not".
model AgentSession {
  id           String   @id @default(uuid())
  orgId        String
  source       String // "claude-code" — the only emitter today
  sessionId    String // the agent's own session.id resource attribute
  repoFullName String // lower-cased "owner/name", matching AiUsageRecord.scopeKey's folding
  // An opaque per-user key (email or id as the exporter sent it). Nullable: a session with no user
  // attribute is still a valid attempt and must not be dropped for lacking attribution.
  userKey      String?
  startedAt    DateTime // earliest datapoint observed for this session
  lastSeenAt   DateTime // latest — sessions arrive across several exports
  tokens       Int      @default(0)
  costCents    Int      @default(0)
  commits      Int      @default(0)
  pullRequests Int      @default(0)
  linesAdded   Int      @default(0)
  linesRemoved Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A session is ONE attempt: re-exported counters must UPDATE the row, never append a duplicate
  // that would inflate the attempt count and deflate cost-per-attempt.
  @@unique([orgId, source, sessionId])
  @@index([orgId, startedAt])
  @@index([orgId, repoFullName])
}

// The org's named, dated TRANSITION PROGRAMME (W1c) — the state that outlives onboarding.
//
// Onboarding's five-step checklist (src/lib/org/getting-started.ts) ends at "invite a teammate",
// which is exactly where the actual job starts. Everything after it was, until now, stateless: the
// dashboard could say where the fleet stood but never "where are we IN something", so a returning
// member had no thread to pick up. A programme is that thread — one per org, named by the people
// doing it ("Agent-ready by Q1"), with a target rung, a date, and a review cadence.
//
// `baselineJson` is the point of the table. Port's AI-SDLC rule is "baseline before you turn
// anything on", and a baseline recomputed from today's data is not a baseline — it moves with the
// thing it is supposed to measure. So the fleet snapshot is FROZEN at creation (ProgramBaseline in
// src/lib/db/org-program.ts) and never rewritten; progress is always today's live rollup read
// against that fixed origin. A programme created before the org's first scan honestly stores a null
// baseline rather than a zeroed one.
//
// One row per org (`orgId` unique) — a programme is the org's current commitment, not a backlog of
// them. Re-targeting edits the row; the audit log carries the history.
model TransitionProgram {
  id           String    @id @default(uuid())
  orgId        String    @unique
  name         String
  // The maturity rung being climbed to, as a LevelId ("L1".."L5") — the vocabulary a programme is
  // actually discussed in, unlike Goal.target which is a 0-100 score. Validated against LEVELS.
  targetLevel  String    @default("L4")
  targetDate   DateTime? // null = open-ended; the strip then omits the pace read rather than faking one
  cadence      String    @default("weekly") // weekly | biweekly | monthly — how often the org reviews
  // Frozen at creation and NEVER rewritten. Null when the org had no scanned repo yet: an honest
  // absent origin, not a zeroed one that would make the first scan look like pure progress.
  baselineAt   DateTime
  baselineJson String?
  status       String    @default("active") // active | paused | achieved
  startedBy    String? // GitHub login who started it
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id])
}

// A tracked, scoped program of work — typically created from a fleet recommendation: "bring
// these N repos up to <target> on <dimension>". Bundles the highest-leverage org move into an
// assignable, status-tracked initiative. `repos` is a JSON string[] of repo fullNames.
model Initiative {
  id            String    @id @default(uuid())
  orgId         String
  title         String
  dimId         String // "D1".."D9"
  practiceId    String? // optional link into the Practice Library
  targetScore   Int       @default(70)
  repos         String    @default("[]") // JSON string[] — repo fullNames in scope
  status        String    @default("open") // open | in_progress | done | dismissed
  assigneeLogin String? // GitHub login of the owner driving the work (null = unassigned)
  targetDate    DateTime? // optional due date the initiative is steered toward (null = open-ended)
  goalId        String? // optional link to the steering Goal this initiative serves (null = standalone)
  playbookId    String? // optional link to the Playbook whose rollout this initiative tracks (null = none)
  createdAt     DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([status])
}

// A company best-practice "playbook" authored by an org owner/admin — the org's own reusable
// standard for a maturity dimension (e.g. "Our CI standard", "Our AGENTS.md template"). Devs browse
// and apply them; later phases tie adoption to dimension lift. `steps` is a JSON string[] of the
// concrete actions. Org-scoped; see src/lib/db/playbooks.ts. Distinct from the DERIVED practice
// library (getOrgPractices), which is inferred from scans rather than authored.
model Playbook {
  id        String   @id @default(uuid())
  orgId     String
  title     String
  dimId     String // "D1".."D9" — the dimension this playbook strengthens
  summary   String   @default("") // what it is / why it matters
  steps     String   @default("[]") // JSON string[] — the concrete starter steps
  createdBy String? // GitHub login of the author
  archived  Boolean  @default(false)
  version   Int      @default(1) // bumped each time the content (title/dim/summary/steps) is edited
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // last content edit (change history anchor)

  org          Organization          @relation(fields: [orgId], references: [id])
  applications PlaybookApplication[]

  @@index([orgId])
}

// Records that a playbook was applied to a repo — the explicit adoption signal (there's no scan
// signal for "this repo adopted playbook X"). Adoption analytics count distinct applied repos and
// measure the dimension-score lift in those repos since `appliedAt`. One row per (playbook, repo).
model PlaybookApplication {
  id             String   @id @default(uuid())
  playbookId     String
  orgId          String // denormalized for org-scoped aggregation
  repoFullName   String
  appliedBy      String? // GitHub login who marked it applied
  appliedVersion Int? // the playbook version this repo adopted (null for pre-versioning marks)
  appliedAt      DateTime @default(now())

  playbook Playbook @relation(fields: [playbookId], references: [id])

  @@unique([playbookId, repoFullName])
  @@index([playbookId])
  @@index([orgId])
}

// One improvement PR opened from the live-wall ship loop (or a future backlog surface): a practice
// starter seeded into a repo after an owner ACCEPTED a triaged recommendation. This is the persistence
// that closes the identify → triage → PR → merge → rescan → impact cycle — the practices-page apply
// flow ends at "draft PR opened", this row carries the PR through merge detection and the post-merge
// score verification. Standalone under relationMode="prisma" (denormalized orgId, no DB FKs), mirroring
// PlaybookApplication. One row per repo × practice (the artifact branch `ascent/{practiceId}` is
// per-repo unique, so a second accept reuses the same PR). See src/lib/db/improvement.ts.
model ImprovementPr {
  id               String    @id @default(uuid())
  orgId            String // denormalized for org-scoped aggregation
  repoFullName     String
  practiceId       String
  dimId            String // "D1".."D9" — the dimension the practice lifts (impact is measured here)
  recommendationId String? // the triaged Recommendation that led to this PR (null = other surfaces)
  prNumber         Int
  prUrl            String
  state            String    @default("open") // open | merged | closed (closed = rejected on GitHub)
  mergedAt         DateTime?
  closedAt         DateTime?
  // Impact bookends: the repo's latest scan when the PR was opened vs the first scan after the merge.
  // impact* stay null until the post-merge scan lands ("awaiting rescan" in the UI).
  baselineScanId   String?
  verifiedScanId   String?
  impactDim        Int?
  impactOverall    Int?
  openedBy         String? // GitHub login who accepted the direction (null = anonymous/dev)
  // MOONSHOT #26 — which surface opened this PR. Defaulted to "practice" so every existing row keeps
  // its meaning; a loop lane's PR writes "loop". The union read folds both into ONE ledger, so the
  // org stops having two incompatible answers to "what did we improve".
  source           String    @default("practice") // practice | loop
  // The LoopRunLane this PR came from, when source = "loop". Null on a practice PR — honest, not 0.
  loopLaneId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // UNCHANGED on purpose (moonshot #26): a loop row takes the synthetic practiceId "loop:<laneId>",
  // which is unique by construction and therefore idempotent under retry — so the ledger needs no
  // second uniqueness rule, and a widened key cannot silently admit duplicate practice PRs.
  @@unique([orgId, repoFullName, practiceId])
  @@index([orgId, state])
  @@index([orgId, createdAt])
  @@index([orgId, loopLaneId])
}

// Team-standings snapshot (Teams tab): the "why the top team leads and the bottom lags" decomposition,
// captured as a durable OUTPUT of a full org scan so the analysis is gathered over time (and can be
// trended) rather than only recomputed at render. One append row per org-scan generation; the Teams
// page reads the latest for provenance ("captured by the org scan on …"). Fully deterministic — derived
// from the team rollup (no LLM). `standingsJson` is the serialized TeamStandings shape (JSON-in-TEXT, no
// jsonb). No DB FK (relationMode="prisma"); written/read via raw SQL. See src/lib/db/team-standings.ts.
model TeamStandingSnapshot {
  id              String   @id @default(uuid())
  orgId           String // denormalized for org-scoped reads
  generatedAt     DateTime @default(now())
  teamCount       Int
  fleetAvgOverall Int
  spread          Int // leader.avgOverall − laggard.avgOverall
  leaderSlug      String
  leaderScore     Int
  laggardSlug     String
  laggardScore    Int
  standingsJson   String // serialized TeamStandings (the full decomposition, for visualization/export)
  source          String   @default("scan") // which pipeline captured it

  @@index([orgId, generatedAt])
}

// Org Skills Library (Feature 2) — a scalable, categorized catalog of reusable Claude/LLM "skills"
// (SKILL.md-like prompt/workflow assets) authored in-app, so members discover and reuse the org's own
// best assets. Mirrors the Playbook stack (org-authored library item + adoption tracking) but adds a
// `category` (indexed) for filtering at scale and a denormalized `downloadCount` for DB-side
// sort-by-most-used. DISTINCT from SkillGeneration (the per-repo onboarding SKILL.md generator) — no
// coupling. `tags` and the body are JSON/TEXT (no jsonb). See src/lib/db/org-skills.ts.
model OrgSkill {
  id              String   @id @default(uuid())
  orgId           String
  name            String // <= 200 chars; unique within the org
  description     String   @default("") // <= 1000
  content         String // the skill body (SKILL.md-like markdown); <= 50KB
  category        String // one of src/lib/org/skill-categories.ts (validated on write)
  tags            String   @default("[]") // JSON string[] — secondary, optional refinement
  version         Int      @default(1) // bumped on a content edit (mirror Playbook), the change-history anchor
  // The sync-manifest change key (diff without shipping the body). `sha256-n1:<hex>` — ONE shared
  // function (contentDigest, src/lib/registry/parse.ts) over the artifact's FULL text: LF-normalized,
  // frontmatter included, uncapped. `n1` names the normalization revision, so a recipe change is
  // visible in the value instead of masquerading as an edit. WAS "sha256 hex of `content`": a bare
  // 64-char hex over the stored, capped body — a different span from the one the catalog hashed, which
  // made a manifest-vs-catalog comparison meaningless. A bare-hex value here is pre-`n1` and means
  // "not comparable, recompute", never "diverged". No column change: this is an unbounded String and
  // the value merely grew 64 -> 74 chars.
  contentHash     String   @default("")
  archived        Boolean  @default(false) // soft archive, not hard delete
  downloadCount   Int      @default(0) // denormalized rolling tally for DB-side sort-by-downloads (§8.8)
  // Registry mirror (UC2). `origin` decides writability: a "hosted" row keeps today's in-app forms;
  // a "registry" row is PR-only and is rewritten by src/lib/registry/index-registry.ts, keyed on
  // (registryId, registryPath). Nullable by design — every pre-registry row reads as hosted.
  origin          String   @default("hosted") // hosted | registry
  registryId      String?
  registryPath    String? // repo-relative path, e.g. "skills/pr-review-rigor/SKILL.md"
  // The change key for the mirrored file, same recipe as `contentHash` above: `sha256-n1:<hex>` from
  // contentDigest over the file's FULL text (LF-normalized, frontmatter INCLUDED) — deliberately a
  // wider span than `content`, which stores the frontmatter-stripped body. WAS "sha256 hex of the file
  // as indexed", which no longer describes either the tag or the normalization.
  registryHash    String?
  registryVersion String? // `version` as declared in the document's frontmatter
  createdBy       String? // GitHub login of the author
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id])
  adoptions OrgSkillAdoption[]

  @@unique([orgId, name])
  @@index([orgId, archived])
  @@index([orgId, category])
  @@index([registryId, registryPath])
}

// Records that a repo adopted a skill — the explicit reuse signal (mirror PlaybookApplication). One row
// per (skill, repo). `orgId` is denormalized for org-level rollups. No DB FKs (relationMode="prisma").
model OrgSkillAdoption {
  id           String   @id @default(uuid())
  skillId      String
  orgId        String // denormalized for org-scoped aggregation
  repoFullName String
  adoptedBy    String? // GitHub login who marked it adopted
  adoptedAt    DateTime @default(now())

  skill OrgSkill @relation(fields: [skillId], references: [id])

  @@unique([skillId, repoFullName])
  @@index([skillId])
  @@index([orgId])
}

// One rolling download/use tally row per skill (mirror QuotaEvent) — org-internal usage
// counter, bumped fire-and-forget on download or "copy for LLM". `OrgSkill.downloadCount` is the
// denormalized mirror used for sorting; this row additionally carries `lastSeen` (and is the seam for a
// future per-day trend). Standalone — keyed by skillId. Block-level @@unique keeps the inline-@unique
// parity list in init-sql.test.ts intact (same generated index name as an inline @unique).
model OrgSkillDownload {
  id       String   @id @default(uuid())
  skillId  String
  count    Int      @default(0)
  lastSeen DateTime @updatedAt

  @@unique([skillId])
}

// Append-only per-use event for an org skill (Feature 2 sync telemetry). One row per reported use so
// "use rate" can be sliced by repo / type / source — richer than the denormalized OrgSkillDownload
// counter (which stays as the hot sort key, bumped in the same path). No FKs (relationMode="prisma").
model OrgSkillEvent {
  id        String   @id @default(uuid())
  skillId   String
  orgId     String // denormalized for org-scoped rollups
  // download | sync | invoke. `invoke` was retired 2026-07-29 for having no producer; moonshot #19
  // gives it one (the CLI/hook/MCP channel), so it is UN-retired rather than re-invented.
  type      String
  repo      String? // reporting repo full name (owner/name), when known
  // Reporting client, now an enum vocabulary: cli | hook | ci | web | registry | mcp. Legacy rows
  // carry the free-text form the shipped CLI emits (e.g. "cli:diverged") and are normalized on READ
  // (normalizeEventSource) — nothing rewrites them, so no destructive migration exists to get wrong.
  source    String?
  // The sub-state the CLI used to smuggle into `source` (the drift state after the colon). Its own
  // column now, so `source` can be an enum without losing what the fleet was already reporting.
  detail    String?
  // Producer session, when one exists — the (session, skill, ts) triple is the event's identity.
  sessionId String?
  // At-least-once de-duplication key. NULLABLE-unique: Postgres treats NULLs as distinct, so a
  // producer that supplies no key is unconstrained and keeps today's append behavior, while one that
  // does gets exactly-once. Same mechanism as Scan.dedupKey.
  dedupeKey String?
  createdAt DateTime @default(now())

  @@unique([skillId, dedupeKey])
  @@index([skillId])
  @@index([orgId, createdAt])
}

// Org-scoped API token for MACHINE access to the Skills Library (a dev repo / CLI / CI registering,
// downloading, or reporting usage without a browser session). Only the SHA-256 hash is stored — the raw
// `askl_…` value is shown ONCE at creation and never again (mirror Invite.token's capability model).
// `scopes` is a comma-joined subset of skills:read | skills:write | telemetry:write. Verified per-request
// by src/lib/api-token-auth.ts. No FKs (relationMode="prisma").
model OrgApiToken {
  id          String    @id @default(uuid())
  orgId       String
  name        String // human label ("CI", "laptop")
  tokenHash   String // sha256 hex of the raw token — the lookup key
  tokenPrefix String // leading chars of the raw token, for display ("askl_ab12cd…")
  scopes      String // comma-joined scope list
  createdBy   String? // GitHub login of the minter
  lastUsedAt  DateTime?
  revokedAt   DateTime? // soft-revoke; a revoked token fails verification but stays for the audit trail
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([tokenHash])
  @@index([orgId])
}

// Shared Org Memory (Memory-as-a-Service MVP) — the org's durable, agent-readable knowledge store:
// decisions, findings, procedures and summaries that would otherwise evaporate per session. A faithful
// subset of docs/memory-as-a-service-design.md §3, scoped to what the existing stack proves cheaply:
// the ORG is the tenant (orgId leads every query, exactly as `project_id` leads the doc's PK), and
// `namespace` is the in-org grouping tag that stands in for the doc's first-class Project until vectors
// + project-scoped API keys earn their keep (§10 build order: prove isolation before embeddings).
//
// The anti-memory-poisoning triad from §3 is present from day one, because shared memory AMPLIFIES bad
// writes: `source`+`createdBy` (provenance — who wrote this), `confidence` (trust score to rank and
// prune on), and `supersededBy` (a correction writes a NEW row and points the old one at it, so history
// and auditability survive instead of leaving a wrong memory beside its fix). Reads drop
// `supersededBy != null` (§7.4) and expired rows (§8 TTL). `visibility='private'` is the doc's
// agent-private scratch, filtered to its author. `tags` is TEXT JSON (no jsonb — the DSQL-safety
// contract this schema keeps). See src/lib/db/org-memory.ts + src/lib/memory/consolidation.ts.
model OrgMemory {
  id             String    @id @default(uuid())
  orgId          String
  namespace      String? // optional in-org grouping tag (the doc's "project" stand-in); null = org-wide
  content        String // the memory body (the searchable payload); <= 20KB
  kind           String    @default("semantic") // episodic | semantic | procedural | summary
  visibility     String    @default("shared") // shared (whole org) | private (author-only)
  source         String? // provenance: the agent/tool/human that produced it
  confidence     Float     @default(1.0) // 0..1 trust score — ranking + pruning
  tags           String    @default("[]") // JSON string[] — secondary, open-ended refinement
  supersededBy   String? // id of the memory that replaced this one (versioning); null = current
  version        Int       @default(1)
  archived       Boolean   @default(false) // soft archive, never a hard delete
  accessCount    Int       @default(0) // denormalized recall/copy tally
  // MOONSHOT #17 — use-evidence from the MCP door, denormalized off OrgMemoryCitation so the Memory
  // tab can rank without a per-row aggregate. `citedCount` is "an agent said it USED this";
  // `notUsefulCount` is "an agent read it and said it did not help" — two facts, never netted into
  // one score, because a memory nobody uses and a memory everybody rejects need different actions.
  citedCount     Int       @default(0)
  notUsefulCount Int       @default(0)
  expiresAt      DateTime? // TTL for ephemeral/scratch memory; null = permanent
  // Registry mirror (UC2) — see OrgSkill.origin for the contract.
  origin         String    @default("hosted") // hosted | registry
  registryId     String?
  registryPath   String? // repo-relative path, e.g. "memory/decision/postgres-over-dynamo.md"
  registryHash   String?
  createdBy      String? // GitHub login of the author
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, archived])
  @@index([orgId, namespace])
  @@index([orgId, kind])
  @@index([registryId, registryPath])
}

// Auto-derived tech-stack group (Feature 3b) — a parallel, immutable grouping of an org's repos by
// detected stack (frontend / backend:<lang> / mobile / data_ml / infra / library), maintained by
// syncTechStackGroups on each scan. Distinct from the user-owned Segment (deliberately separate so
// auto-groups don't clutter the Segments UI). Multi-membership: a fullstack repo is in several groups.
// `key` is the stable identity (see techGroupsFor in src/lib/org/tech-stack.ts); `label` is display.
model TechStackGroup {
  id        String   @id @default(uuid())
  orgId     String
  key       String // "frontend" | "backend:node" | "backend:python" | "mobile" | "data_ml" | "infra" | "library"
  label     String // "Frontend", "Backend · Python"
  updatedAt DateTime @updatedAt

  org     Organization           @relation(fields: [orgId], references: [id])
  members TechStackGroupMember[]

  @@unique([orgId, key])
  @@index([orgId])
}

// Membership of a repo in a tech-stack group — the auto-maintained join (reconciled per scan). One row
// per (group, repo). Standalone cascade at the Prisma layer (no DB FKs under relationMode="prisma").
model TechStackGroupMember {
  id      String @id @default(uuid())
  groupId String
  repoId  String

  group TechStackGroup @relation(fields: [groupId], references: [id])
  repo  Repository     @relation(fields: [repoId], references: [id])

  @@unique([groupId, repoId])
  @@index([groupId])
  @@index([repoId])
}

// Per-org connected LLM (BYOM — Feature 1). One row per org: the org's own Amazon Bedrock provider so
// inference runs in THEIR AWS account/region/bill (the enterprise privacy unlock). The credential is
// stored ONLY in `credentialsEncrypted` (AES-256-GCM via src/lib/crypto/secret-box.ts) — never a plain
// column, never returned by the API, decrypted only at provider-construction time. `enabled=false`
// lets an org save+test before going live (or support pause a misconfig). Enterprise-plan gated +
// fail-closed without ENCRYPTION_KEY. See src/lib/db/org-llm.ts.
model OrgLlmConfig {
  id                   String    @id @default(uuid())
  orgId                String
  provider             String    @default("bedrock") // "bedrock" (v1); future: openai | vertex | self_hosted
  enabled              Boolean   @default(false) // configured-but-paused vs active
  modelId              String // e.g. "us.anthropic.claude-sonnet-4-6"
  region               String? // bedrock region
  authMode             String    @default("static") // "static" | (future) "assume_role"
  // Encrypted JSON blob (secret-box v1): { accessKeyId, secretAccessKey }. Null = no creds stored yet.
  credentialsEncrypted String?
  lastValidatedAt      DateTime? // set by the test-connection endpoint
  lastValidationError  String?
  createdBy            String? // GitHub login
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId])
}

// The org's published AI stance (W3) — the versioned "what may AI do here" policy artifact the
// research names the #1 governance capability. VERSIONED ROWS (mirror the Playbook versioning
// precedent, but immutable-per-publish): each publish appends a row at version N+1 and marks the
// prior published row "superseded", so history is complete and an acknowledgement can pin the exact
// text a repo adopted. At most one "draft" and one "published" row per org at a time. `stanceJson`
// is the serialized AiStance (JSON-in-TEXT — the schema's no-jsonb DSQL-safety contract, exactly
// like Organization.gatePolicy), sanitized at the edge in src/lib/db/org-stance.ts via
// sanitizeStance (src/lib/org/stance.ts). Compliance is DERIVED at read time from existing scan
// data (declared vs observed attribution) — never stored, so it can't go stale.
model OrgAiStance {
  id          String    @id @default(uuid())
  orgId       String
  version     Int // 1..N, unique per org; a draft holds the version it will publish as
  status      String    @default("draft") // draft | published | superseded
  stanceJson  String // serialized AiStance (see src/lib/types.ts)
  publishedBy String? // GitHub login who published (null while draft)
  publishedAt DateTime? // null while draft
  createdAt   DateTime  @default(now())

  @@unique([orgId, version])
  @@index([orgId, status])
}

// A repo's acknowledgement of an org-level artifact version — "this repo has adopted stance vN".
// The per-repo ⇄ org-artifact-version link the Perimeter prototype named as the single biggest
// schema gap: nothing recorded adoption of an org artifact before this. One row per
// (org, artifact, repo): re-acknowledging a NEWER version UPDATES the row (mirror OrgDecision's
// sparse-upsert shape — an unacked repo has no row at all). `artifact` is "ai-stance" today; the
// column exists so a later org artifact (e.g. a published autonomy writ) can reuse the primitive
// without a second table, but nothing here is generalized beyond that name. Standalone under
// relationMode="prisma" (denormalized orgId, no DB FKs), always queried by orgId.
model OrgArtifactAck {
  id           String   @id @default(uuid())
  orgId        String
  artifact     String   @default("ai-stance") // which org artifact kind was acknowledged
  version      Int // the artifact version the repo acknowledged
  repoFullName String // "owner/name"
  ackedBy      String? // GitHub login
  ackedAt      DateTime @default(now())

  @@unique([orgId, artifact, repoFullName])
  @@index([orgId, artifact, version])
}

// Normalized AI-usage records feeding the /delivery AI ROI resolver (integrations increment 2). One
// row per (source, scope, scopeKey, day). scope=repo carries MEASURED per-repo spend (Claude Code OTel
// git.repository); scope=org an ALLOCATED total (Copilot/OpenAI, distributed to repos by git evidence).
// Denormalized orgId, no relation — mirrors ImprovementPr (relationMode="prisma" emits no FKs).
model AiUsageRecord {
  id          String   @id @default(uuid())
  orgId       String
  source      String // "claude-code" | "copilot" | "openai"
  scope       String // "repo" | "user" | "team" | "org"
  scopeKey    String // repo fullName | user email | team slug | org slug
  periodStart DateTime // UTC day-bucket start
  tokens      Int      @default(0)
  costCents   Int      @default(0)
  sessions    Int      @default(0)
  seats       Int      @default(0)
  fidelity    String // "measured" | "allocated"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, source, scope, scopeKey, periodStart])
  @@index([orgId, source])
}

// Server-side session revocation. The signed session cookie embeds the `sv` (session
// version) it was minted at; getSessionState re-checks it against this row on every
// resolve and rejects the cookie once the stored version is higher. Bumping the version —
// on logout, or when an installation the login owns is removed — invalidates every
// outstanding token for that login immediately, instead of waiting out the cookie TTL
// (the gap that made "logout" only delete the local cookie). Keyed by the GitHub login
// (lowercased), the same identity carried in the session. No row == version 0, so a
// never-revoked user costs nothing to store. Standalone (no FKs under relationMode =
// "prisma"); always read/written by its primary key. See src/lib/db/sessions.ts.
model SessionRevocation {
  login     String   @id // GitHub login, lowercased — matches Session.login
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Cross-instance webhook replay/idempotency store (github-app-installation-webhooks #3). GitHub stamps
// each delivery with a unique X-GitHub-Delivery id; a captured, still-validly-signed delivery can be
// re-sent to re-trigger scans/gates. The webhook route's in-memory Map collapses only SAME-instance
// replays — on a horizontally-scaled / serverless deploy every instance starts empty, so a replay routed
// to another instance isn't deduped. This shared TTL store makes the claim AUTHORITATIVE across instances:
// a row is the "claimed" mark (id = delivery id), kept until `expiresAt`, and DELETED when the deferred
// processing fails so a GitHub redelivery can retry. Accessed via raw SQL (no typed model accessor) and
// swept of expired rows opportunistically. Standalone under relationMode = "prisma" (no FKs); read/written
// by its primary key. See src/lib/db/webhook-deliveries.ts.
model WebhookDelivery {
  id        String   @id // GitHub X-GitHub-Delivery id
  expiresAt DateTime // TTL horizon; rows past this are sweepable and may be re-claimed
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Soft weekly quota for anonymous public scans, keyed by a SALTED HASH of the client IP (never the
// raw IP — avoids persisting PII). Persistent + cross-instance, which is the whole point: a 7-day
// window can't live in the per-minute in-memory burst limiter (src/lib/rate-limit.ts), since
// serverless instances reset and each keeps its own Map. This is a deliberately SOFT gate —
// knowingly attackable (IP rotation, shared NAT/CGNAT collisions) — that caps casual repeat use of
// the free, no-signup public scan and nudges heavy users to sign in. Enforced only when persistence
// is configured; the scan path fails OPEN if this store hiccups. `hits` is a JSON number[] of
// epoch-ms scan timestamps inside the rolling window, trimmed on each write. See
// src/lib/public-scan-quota.ts. Standalone under relationMode = "prisma" (no FKs); read/written by
// its primary key. Stale rows are swept by the retention purge job (src/lib/db/retention.ts).
model PublicScanQuota {
  ipHash    String   @id // SHA-256(salt + ":" + clientIp), hex — never the raw IP
  hits      String   @default("[]") // JSON number[] of epoch-ms timestamps in the rolling 7-day window
  updatedAt DateTime @updatedAt
}

// Public-funnel abuse observability (QUOTA-6): a running tally bumped fire-and-forget when the free
// funnel pushes back — a weekly-quota denial or a rate-limit trip — so /usage can show how often the
// guardrails fire. `kind` = "quota_deny" | "rate_limit"; `scope` = "anon"/"user" (quota) or the
// limiter name ("gate", …). No FK; keyed by the unique pair. Written best-effort from
// src/lib/public-scan-quota.ts; read by src/lib/db/quota-events.ts.
model QuotaEvent {
  id        String   @id @default(uuid())
  kind      String
  scope     String
  count     Int      @default(0)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([kind, scope])
}

// A record of each onboarding-skill generation (STD-6) — turns the one-off SKILL.md download into a
// tracked program: which tracks a repo's skill targeted, at which commit, when. `trackIds` is a JSON
// string[] of practice ids. Keyed by repoFullName; written best-effort from the skill route, read by
// src/lib/db/skill-history.ts to show a "skill history" + track-set diff on the report.
model SkillGeneration {
  id           String   @id @default(uuid())
  repoFullName String
  headSha      String?
  trackIds     String   @default("[]")
  generatedAt  DateTime @default(now())

  @@index([repoFullName])
}

// A SAVED Roadmap Sandbox scenario: the what-if a leader modeled on one repo's report, kept whole.
//
// The sandbox recomputes a projected score live from per-dimension overrides (see projectSandbox), and
// every bit of that lived in React state — a reload erased the model that produced the "+12 points" a
// team had just talked itself into. Committing it wrote a STATUS FLIP plus a prose note with the delta
// rounded into the sentence, so the number could only ever be read back by parsing English and the
// override values that produced it were stored nowhere at all. This model is that missing state.
//
// Three deliberate shapes:
//   - `projectedDelta` (and score/level) are NUMBERS. A projection that has to be regex'd out of a
//     note is a projection nothing can reconcile against.
//   - `itemKeysJson` holds recommendationDecisionKey identities (src/lib/report/rec-identity.ts) —
//     the same cross-scan key the dismissal decisions use — NOT the fragile dimension+title pair and
//     NOT scan-bound Recommendation.ids, which die on the next scan. A scenario therefore still knows
//     which gaps it covered after a re-scan reworded and re-rowed them.
//   - `baselineScore`/`baselineLevel`/`baselineScanAt` pin WHAT the projection was relative to, which
//     is what makes projected-vs-actual answerable later: the next scan of this repo is compared
//     against the state the model was built on, not against whatever is current now.
//
// One scenario per (org, repo, author) — saving replaces. Scenario naming, comparison and sharing are
// explicit non-goals; this is "my current plan for this repo", restored where I left it. `authorLogin`
// is "" when the session has no resolvable login, which scopes that scenario to the org rather than to
// a person (the tenant gate on the route is what keeps it private either way).
model SandboxScenario {
  id             String   @id @default(uuid())
  orgId          String // tenant scope — resolved server-side from the repo, never from the request
  repoFullName   String // "owner/name"
  authorLogin    String   @default("") // GitHub login who modeled it; "" = no resolvable login
  baselineScore  Int // the report's overall score the scenario was modeled against
  baselineLevel  String // e.g. "L3"
  baselineScanAt DateTime // scannedAt of the scan it was modeled on — the reconciliation anchor
  overridesJson  String   @default("{}") // JSON Record<DimensionId, number> — the slider state
  itemKeysJson   String   @default("[]") // JSON string[] of recommendationDecisionKey identities
  projectedScore Int
  projectedLevel String
  projectedDelta Int // projectedScore − baselineScore, stored as a number
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, repoFullName, authorLogin])
  @@index([orgId, repoFullName])
}

// A Custom-plan enquiry submitted from the /pricing card's form (the tier stored as `enterprise`, shown
// as "Custom"). The tier has no checkout — its price is negotiated — so this row IS the lead, and the
// operator mail (src/lib/email/plan-enquiry.ts) is only a notification about it. Persisted FIRST for
// exactly that reason: a Resend/SES outage or a bounced operator inbox must not lose a prospect, so
// `emailStatus` records what happened to the notification without the enquiry depending on it.
//
// `areasJson` is a JSON string[] of ENQUIRY_AREAS ids (hosting / scans / support / customization / sso —
// see src/lib/plan-enquiry.ts), `fleetSize` one of FLEET_SIZES or "". `viewerLogin`/`orgSlug` are filled
// server-side from the session when the visitor happened to be signed in, never from the request body.
// Standalone under relationMode = "prisma" (no FKs) — a prospect has no Organization yet by definition.
model PlanEnquiry {
  id          String   @id @default(uuid())
  plan        String   @default("enterprise") // the stored PlanId enquired about
  name        String
  email       String
  company     String   @default("")
  fleetSize   String   @default("")
  areasJson   String   @default("[]")
  message     String
  viewerLogin String? // GitHub login, when the submitter was signed in
  orgSlug     String? // org they were browsing as, when resolvable
  emailStatus String   @default("pending") // sent | skipped (no provider) | failed
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// UC2 "Registry" — the customer-owned registry repo ascent onboards, indexes and tracks.
// See docs/REGISTRY-AND-CARE-IMPL.md §1–§3. Every column here is ADDITIVE and nullable/defaulted, so
// an existing database migrates on read (and the PGlite dev boot's drift repair can add them).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// One row per MAPPED registry repo (`<org>/ai-registry` by default; any repo can be mapped). The org
// keeps exactly one `canonical` registry — the one every fleet view merges first on name collision —
// and may map further team-level registries beside it. Standalone under relationMode = "prisma" (no
// FKs), like Deployment/OrgSkillEvent: `orgId` leads every query.
//
// `status` is the onboarding state machine the Registry tab renders:
//   unmapped -> scaffolding -> scaffold_pr_open -> indexed, with `error` reachable from any state
//   (the last index attempt failed; `lastError` says how, and the previous index stays readable).
// `mode` decides who may write: git_native = PR-only (the registry is the source of truth),
// hosted_mirror = ascent still writes its own tables and the repo is a mirror.
model OrgRegistry {
  id                 String    @id @default(uuid())
  orgId              String
  repositoryId       String? // Repository row of the registry repo (role = "registry"), when one exists
  fullName           String // "owner/name"
  defaultBranch      String    @default("main")
  canonical          Boolean   @default(true)
  mode               String    @default("git_native") // git_native | hosted_mirror
  telemetrySink      String    @default("off") // api | registry | off
  status             String    @default("unmapped") // unmapped | scaffolding | scaffold_pr_open | indexed | error
  lastIndexedAt      DateTime?
  lastIndexSha       String? // commit sha the last successful index read
  catalogSha         String? // sha of the catalog.json ascent last wrote
  webhookHealthy     Boolean   @default(false)
  policiesJson       String? // JSON of `.ascent/registry.yaml -> policies`
  migrationJson      String? // JSON Record<"skills"|"practices"|"memory", {state, prUrl?, moved, total}>
  scaffoldPrUrl      String?
  lastError          String?
  // Denormalized index result, so the tab's header renders without re-counting mirror rows.
  skillCount         Int       @default(0)
  practiceCount      Int       @default(0)
  memoryCount        Int       @default(0)
  lessonCount        Int       @default(0)
  // The `usage/` lane, aggregated at index time. Ascent READS this lane; the installations that run
  // skills are what count invocations, locally, and contribute an aggregate. `usageContributors = 0`
  // means nobody is reporting — which is not the same as a fleet that runs nothing.
  usageInvokes30d    Int       @default(0)
  usageContributors  Int       @default(0)
  // The knowledge/ lane as its generated per-bundle indexes state it. JSON rather than columns
  // because the row count is the BUNDLE count (one, today; a handful ever) and every field is
  // owned by the bundle's own generator — normalizing it into tables would make ascent look like
  // an authority for numbers it only reads.
  bundlesJson        String    @default("[]")
  // Denormalized knowledge-lane counts from the last index pass (moonshot #18), so the Registry tab's
  // header renders without counting OrgKnowledgeSubject rows. `signalsContributor` is the contributor
  // id THIS org publishes its own signals under (null = the org contributes nothing back).
  subjectCount       Int       @default(0)
  signalContributors Int       @default(0)
  signalsContributor String?
  warningsJson       String    @default("[]") // JSON string[] — files the last index skipped, with why
  createdBy          String? // GitHub login that mapped it
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([orgId, fullName])
  @@index([orgId, canonical])
}

// The org's PRACTICE SHAPES as mirrored from `practices/<slug>/PRACTICE.md` in the registry (the
// leak-free shape, never a customer artifact body). A hosted row (origin = "hosted") is one ascent
// authored itself; a registry row is PR-only and rewritten by the indexer. Distinct from the
// per-scan `Scan.practiceShape` blob, which is MINED structure from a repo — this is the CHOSEN,
// published shape the fleet adopts.
model OrgPracticeShape {
  id           String   @id @default(uuid())
  orgId        String
  slug         String // kebab-case directory name under practices/
  practiceId   String   @default("") // maps to the practice catalog id when recognized
  dimension    String   @default("") // D1..D10, when declared
  title        String   @default("")
  appliesWhen  String   @default("") // frontmatter `applies-when`
  content      String // the PRACTICE.md body (frontmatter stripped)
  // `sha256-n1:<hex>` from contentDigest over the file's FULL text (LF-normalized, frontmatter
  // INCLUDED) — the same one shared function every other change key in this schema uses, and a wider
  // span than `content` above (which is frontmatter-stripped). WAS "sha256 hex of the raw file":
  // untagged raw bytes, so a CRLF checkout reported every artifact as diverged forever.
  contentHash  String   @default("")
  archived     Boolean  @default(false) // soft archive — a vanished registry path is archived, never deleted
  origin       String   @default("hosted") // hosted | registry
  registryId   String?
  registryPath String?
  registryHash String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId, archived])
  @@index([registryId, registryPath])
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// LOCAL-MODE LOOP RUNS — the durable spine under the war room's autopilot (self-hosted only).
//
// The original autopilot kept its whole state in a process Map: one org, one repo, one branch, and a
// log that died with the node process. The loop run is the same mechanics (worktree → local Claude
// agent → rescan) widened on two axes that the in-memory design could not carry:
//
//   • A SELECTED SET of repos, worked with bounded parallelism (one LANE per repo per cycle), so a
//     fleet-wide improvement pass is one reviewable run rather than N sequential arms.
//   • DURABILITY. The DB is the source of truth for phase, log, branch and outcome ids. A restart
//     loses only the live process handles — which is why a `running` row with no live handle is
//     reconciled to `stopped` (see markStaleRunsStopped) instead of being trusted.
//
// JSON-in-TEXT (`reposJson`, `batchIdsJson`, `closedIdsJson`) follows this schema's no-jsonb DSQL
// contract, exactly like `areasJson` / `warningsJson` above. Standalone-ish under
// relationMode = "prisma": relations are declared for Prisma-side integrity, and (like every other
// model here) no ON DELETE is emitted — cascades are the application's job.
// ─────────────────────────────────────────────────────────────────────────────────────────────────

model LoopRun {
  id          String    @id @default(uuid())
  orgId       String
  createdBy   String? // GitHub login that armed the run
  // curating | running | done | stopped | error.  `curating` is the pre-start state a run sits in
  // while a human edits the proposed batches; `start` writes `running` directly.
  phase       String    @default("curating")
  reposJson   String    @default("[]") // JSON string[] of "owner/name", the run's selected set
  concurrency Int       @default(2) // lanes in flight at once (capped at LOOP_CONCURRENCY_CAP)
  maxCycles   Int       @default(3)
  cycle       Int       @default(0) // the cycle currently being worked (0 = none started yet)
  curated     Boolean   @default(false) // true when the operator approved the batches by hand
  // What this run's agent sessions were armed with, RESOLVED at arm time (the operator's pick, else
  // the deployment's CLAUDE_MODEL / ASCENT_AGENT_EFFORT). Persisted because the ledger compares lifts across
  // runs, and a lift from `sonnet` at default effort and one from `opus` at high effort are results
  // from two different setups. Resolved rather than raw: a null would mean "whatever the env said that
  // day", which is exactly the fact that cannot be recovered afterwards.
  // `effort` stays NULL when no level was chosen — the CLI flag is then not passed at all.
  model       String?
  effort      String?
  // MOONSHOT #27 — how this run spends models. `single` = every lane runs the one resolved model;
  // `ab` = the run pairs its lanes across two models so a cost/lift comparison is a MEASUREMENT
  // rather than a comparison across two runs that differed in a dozen other ways.
  modelPolicy String    @default("single") // single | ab
  // JSON string[] (TEXT, never jsonb) of the models this run is armed with, IN ORDER: ["sonnet"] for
  // a `single` run, the two arms for an `ab` run. Defaulted to "[]" so a pre-#27 row reads as "not
  // recorded" without a nullable column the readers would each have to interpret.
  modelsJson  String    @default("[]")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  org   Organization  @relation(fields: [orgId], references: [id])
  lanes LoopRunLane[]

  @@index([orgId, createdAt])
}

// One repo's work for one cycle of a run. The unit of parallelism, of retry, and of the UI's row.
model LoopRunLane {
  id            String    @id @default(uuid())
  runId         String
  repoFullName  String // "owner/name"
  cycle         Int       @default(1)
  phase         String    @default("queued") // queued | dispatching | rescanning | done | error
  branch        String? // ascent/loop-<stamp>-<repo> — the deliverable; survives the run
  batchIdsJson  String    @default("[]") // JSON string[] of Recommendation ids dispatched
  closedIdsJson String    @default("[]") // JSON string[] of ids the rescan's trailers closed
  commits       Int       @default(0)
  beforeScanId  String? // scan the lane started from (the repo's latest at dispatch time)
  afterScanId   String? // scan the lane's rescan produced — the two ends of the lane's diff
  // Live sub-stage of the lane's rescan (fetch | tree | files | analyze | score | compose), so the
  // wall can show what a long scan is doing instead of a static "rescanning".
  stage         String?
  log           String    @default("") // newline-joined, bounded to LANE_LOG_LINES
  error         String?
  startedAt     DateTime?
  endedAt       DateTime?

  // ── MOONSHOT #27 — remediation economics. ONE declared cost source per lane (`costSource`), never
  // a sum of two: an envelope figure added to an OTLP figure double-counts the same tokens. Every
  // measurement here is NULLABLE because a lane whose agent reported nothing is UNKNOWN, and a 0
  // written in its place would be averaged as a free session.
  model           String? // the model this lane actually ran ("sonnet", …). Null = a pre-#27 row.
  costSource      String? // "envelope" — the ONE declared source. Never summed with another.
  // MICRO-CENTS (round(total_cost_usd * 100 * 1e6)), so a 0.4¢ session is not rounded to zero.
  // Every display divides. Null = unknown, which is NOT zero cost.
  costMicros      Int?
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  turns           Int?
  agentDurationMs Int?
  // The CLI's own session id when it reported one — A JOIN KEY ONLY. It is never used to add an
  // AgentSession row's costCents to this lane's cost (that is the one-source rule above).
  agentSessionId  String?
  abPairKey       String? // joins the two arms of one `ab` pair; null on a `single` run

  // ── MOONSHOT #25 — the lane's org brief and the report the agent wrote back.
  // PROVENANCE of the brief (which playbook + version, which mined practice, which memory ids,
  // which skills, byte sizes) — not its prose, which is rebuilt deterministically from these.
  briefJson  String @default("{}")
  // The parsed `.ascent/lane-report.json`, verbatim after validation, so a verdict is auditable
  // against what the agent actually claimed rather than against a re-derivation of it.
  reportJson String @default("{}")

  // ── MOONSHOT #26 — the lane's PR, denormalized so the cockpit renders it without a join.
  dimId    String? // dominant dimension of the batch; HONEST NULL when it was empty or spanned none
  prNumber Int?
  prUrl    String?

  // ── MOONSHOT #3 — the work lease. LANDED HERE, DELIBERATELY UNUSED until W4-N builds the
  // agent-neutral work protocol (00-INDEX §5 Wave 2, overriding #3's own "wave-4 pass"): a lease
  // column added a wave after the rows it must protect is a wave of unleased rows. `executor`
  // defaults to "local" so every existing lane keeps its current meaning exactly.
  executor   String    @default("local") // local | remote-agent | human
  claimedBy  String? // opaque actor id of the claimant; null = unclaimed
  leaseUntil DateTime? // null = no lease held. An expired lease is releasable, never a zombie claim.

  // ── WAVE 2 — what the lane DELIVERED, as headlines (JSON LaneDeliverable[], src/lib/db/loop-runs-
  // types.ts). Written at lane end from the agent's RESOLVED claims + the attributable diff; NULL on a
  // row written before the column, which the read side backfills deterministically from the diff.
  deliverablesJson String?

  run LoopRun @relation(fields: [runId], references: [id])

  @@index([runId])
}

// A DRIVE: the sequence of loop runs that pulls a fleet toward green (src/lib/local/drive.ts).
//
// The runs it dispatches were always durable; the drive's own INTENT was not — it lived in a Map on
// globalThis, so a restart mid-drive ended it silently and a status read afterwards reported nothing
// at all. A row that reads `running` while no process is driving is the same lie a stale LoopRun row
// is, so it gets the same treatment: the boot sweep reconciles it to `interrupted`, which is a phase
// a human can act on rather than a job that looks alive forever.
//
// Deliberately NOT auto-resumed. A drive spends agent sessions and money; re-arming one is a
// decision, so `interrupted` is terminal and `resumedFrom` records the chain the operator restarted.
model LoopDrive {
  id              String    @id @default(uuid())
  orgId           String
  createdBy       String? // GitHub login that armed the drive
  // running | green | dry | ceiling | stopped | interrupted | error
  phase           String    @default("running")
  reposJson       String    @default("[]") // JSON string[] of "owner/name" — the drive's scope
  maxRuns         Int       @default(3) // the rope, spanning the whole resume chain
  maxCycles       Int       @default(3)
  concurrency     Int       @default(2)
  // Runs already spent by the drives this one resumed. The cap counts the CHAIN, not the segment,
  // so resuming can never hand an agent more rope than the operator originally allowed.
  runsBefore      Int       @default(0)
  resumedFrom     String? // the interrupted drive this one continues
  runsJson        String    @default("[]") // JSON DriveRunRecord[]
  measurementJson String? // JSON DriveMeasurement — the latest fleet score, or null before the first
  stopRequested   Boolean   @default(false)
  // The agent configuration the drive arms EVERY run it dispatches with, so a multi-run drive is one
  // experiment rather than several. Same resolved-at-arm-time contract as LoopRun.
  model           String?
  effort          String?
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  endedAt         DateTime?
  error           String?

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// ATHENA — the resident, ORG-SCOPED companion. One mind per organization.
//
// Her EPISODES are not here: they reuse OrgMemory (namespace "athena", kind "episodic", source
// "athena" — see src/lib/db/athena-episodes.ts), because an episode is exactly what that store
// already models, and duplicating it would fork the org's memory in two.
//
// Her IDENTITY does need its own table, for three reasons the memory store cannot express:
//   • IMMUTABILITY. updateOrgMemory (src/lib/db/org-memory.ts) patches any id it is handed; there is
//     no write-ACL a constitution could hide behind.
//   • TAXONOMY. normalizeMemoryKind (src/lib/org/memory-kinds.ts) coerces any unknown kind to
//     "semantic", so a "constitution" kind would silently become an ordinary fact.
//   • DECAY. A row whose kind is not in DECAY_EXEMPT_KINDS (src/lib/memory/decay.ts) is scored, aged
//     and archived by selectDecayed. A constitution that can be forgotten is not a constitution.
//
// The four models below are additive and JSON-in-TEXT (`metaJson`, `payloadJson`), following this
// schema's no-jsonb DSQL contract. Like every other model here, relations exist for Prisma-side
// integrity only — relationMode = "prisma" emits no ON DELETE, so the delete graph is the
// application's job (eraseOrgAthena, src/lib/db/retention.ts).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// One conversation with Athena. TITLES ARE DERIVED from the first user message and never typed: a
// title box is a chore the operator pays before saying anything, and the thing they were going to
// say IS the title. See deriveThreadTitle (src/lib/db/athena-threads.ts).
model AthenaThread {
  id        String   @id @default(uuid())
  orgId     String
  title     String   @default("") // derived, never user-entered; "" until the first user turn lands
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id])
  turns     AthenaTurn[]
  proposals AthenaProposal[]

  // The thread list is "this org's conversations, most recently active first" — one index serves it.
  @@index([orgId, updatedAt])
}

// One message in a thread. `metaJson` carries everything the transcript needs to REPLAY the turn as
// it was rendered: blocks, recall chips, proposal ids, the phase trail, `grounding` and `truncated`.
model AthenaTurn {
  id           String   @id @default(uuid())
  threadId     String
  role         String // "user" | "assistant"
  content      String
  metaJson     String   @default("{}") // JSON object (TEXT) — blocks, chips, proposalIds, phases, grounding, truncated
  // TOKEN COUNTS ARE NULLABLE ON PURPOSE, and `null` must never be written as `0`. A provider that
  // reports no usage (a local model, a degraded path) is UNKNOWN, not free — and a `0` would be
  // averaged and summed downstream as if it were a measurement. Unknown is not a value.
  inputTokens  Int?
  outputTokens Int?
  legs         Int? // agent legs (tool round-trips) this turn took; null = not instrumented
  createdAt    DateTime @default(now())

  thread AthenaThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

// Something Athena ASKED FOR that a human has not yet answered. `kind` is an action id (the action
// the acceptance would run) or "identity_diff" (a change to her self-model). The OUTCOME of a
// resolution is merged into `payloadJson` rather than given its own column: an outcome is
// kind-shaped — a run id here, an anchored diff result there — and a single column would either be
// a second JSON blob or a lowest-common-denominator string that loses the useful half.
model AthenaProposal {
  id          String    @id @default(uuid())
  orgId       String
  threadId    String
  turnId      String // the assistant turn that raised it (scalar: the turn owns no proposal list)
  kind        String
  payloadJson String    @default("{}") // JSON object (TEXT) — the ask, and after resolution its outcome
  status      String    @default("open") // open | accepted | declined
  resolvedAt  DateTime?
  resolvedBy  String? // GitHub login of the human who answered
  createdAt   DateTime  @default(now())

  org    Organization @relation(fields: [orgId], references: [id])
  thread AthenaThread @relation(fields: [threadId], references: [id])

  // "What is still open for this org" is the badge query, and the only one that must stay cheap.
  @@index([orgId, status])
  @@index([threadId])
}

// Athena's identity, in two tiers, one row each per org.
//
//   • "constitution" — who she is and what she may never do. WRITTEN ONCE, at seed time, BY A HUMAN
//     PATH. There is deliberately NO exported function that can update a constitution row (see
//     src/lib/db/athena-identity.ts): the lock is the ABSENCE of a writer, not a runtime `if` that a
//     later refactor could "simplify" away.
//   • "self_model" — what she has learned about this org and how to work with it. Mutable, but only
//     through the anchored-diff engine (src/lib/athena/identity-diff.ts), and only after a human
//     accepts an `identity_diff` proposal.
//
// `content` is MARKDOWN with stable `## ` sections, not a JSON blob, so the anchored diff has real
// anchors to bind to — and so a future export seam can hand the document to another substrate
// unchanged. `version` increments on every accepted diff; `updatedBy` is the accepting human.
model AthenaIdentity {
  id        String   @id @default(uuid())
  orgId     String
  tier      String // "constitution" | "self_model"
  content   String   @default("")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String? // GitHub login of the human who accepted the diff; null for the seed

  org Organization @relation(fields: [orgId], references: [id])

  // One constitution and one self-model per org — "one mind per organization" as a fact of the
  // schema rather than a convention the read layer hopes for.
  @@unique([orgId, tier])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// MOONSHOT WAVE 1 — additive models landed by the wave-1 schema pass (docs/specs/moonshot/00-INDEX.md
// §5). Every one is append- or upsert-shaped, every JSON payload is TEXT (never jsonb — DSQL/PGlite),
// and every column that reports a MEASUREMENT is nullable: a provider that reported nothing is
// UNKNOWN, and a 0 written in its place would be summed downstream as if it had been measured.
// Erase/purge cascades for these tables are hand-written in src/lib/db/retention.ts.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// #9 — MEASURED lift per intervention. The table holds measured FACTS ONLY: a row exists only when
// both scan bookends exist AND rubricVersion + engineProvider matched on both sides, so the aggregate
// can never be diluted by a fabricated zero. An unmeasured case produces NO row (its named status
// lives in the reader that computes it). See src/lib/db/outcomes.ts.
model InterventionOutcome {
  id             String   @id @default(uuid())
  orgId          String // tenant scope; denormalized like ImprovementPr.orgId
  repoFullName   String // "owner/name"
  kind           String // practice | skill | recommendation | scenario
  // practice→practiceId; skill→skillId; recommendation→recommendationMatchKey(dimId,title);
  // scenario→sorted itemKeys joined and hashed. Must recompute to the same string on the next scan.
  identityKey    String
  dimId          String? // HONEST NULL = a whole-scan outcome (scenario), never "0"
  beforeScanId   String
  afterScanId    String
  interventionAt DateTime // merge / adoption / done-event / scenario-save instant
  overallDelta   Int
  dimDelta       Int? // null when dimId is null OR the dim is absent on either side
  rubricVersion  String // the instrument BOTH sides agreed on — a mismatch writes no row at all
  engineProvider String
  gapDays        Int // whole days before.scannedAt → after.scannedAt
  withinBound    Boolean // reuses skill-outcomes.ts' pairing bound
  isPrivateRepo  Boolean // copied from Repository.isPrivate at write time; the corpus filter
  sourceRowId    String? // ImprovementPr.id / adoption id / Recommendation.id — provenance
  recordedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, kind, identityKey, beforeScanId, afterScanId])
  @@index([orgId, kind, dimId])
  @@index([identityKey, dimId])
  @@index([orgId, recordedAt])
}

// #11 — every model call this deployment served, one row per metered leg (or per tool loop).
// STANDALONE (no Organization relation — additive-only, mirroring QuotaEvent). The `scan` lane keeps
// its authoritative ledger in Scan and is UNIONed on read; this table carries the lanes that had none.
model UsageEvent {
  id               String   @id @default(uuid())
  orgId            String
  lane             String // scan | athena | memory | briefing | local
  legKind          String? // the raw LlmLegKind when one existed; null for lanes off the seam
  refId            String? // Scan.id / LoopRunLane.id when the caller has one; null is honest
  repoId           String?
  repoFullName     String?
  teamKey          String? // normalized "@org/team" from RepoTeam.slug; null = org-wide work
  provider         String
  model            String
  byom             Boolean? // null = unknown provenance = Ascent's account (Scan.engineByom's rule)
  inputTokens      Int? // NULL = the provider reported nothing. NEVER write 0.
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  costMicros       Int? // USD micros; NULL when unpriced, BYOM, or a zero-cost provider
  status           String   @default("success") // success | error | timeout
  latencyMs        Int?
  // "<lane>:<refId>" when a caller owns a stable id; else null. Nullable-unique — NULLs are distinct,
  // which IS the intended at-least-once fallback (Scan.dedupKey precedent). Declared BLOCK-level
  // (@@unique) rather than inline so init-sql.test.ts' deliberately-pinned inline-@unique roster stays
  // the reviewed list it is; the emitted constraint (UsageEvent_idemKey_key) is identical either way.
  idemKey          String?
  createdAt        DateTime @default(now())

  @@unique([idemKey])
  @@index([orgId, createdAt])
  @@index([orgId, lane, createdAt])
  @@index([orgId, teamKey, createdAt])
}

// #14 — one entry mirrored out of a repo's `.ai/memory/`. QUARANTINED, repo-authored content: `body`
// is capped by the parser and never scored, and `skipReason` records why an entry did not reach
// OrgMemory rather than dropping it silently. See src/lib/memory/repo-memory-mirror.ts.
model RepoMemoryMirror {
  id           String   @id @default(uuid())
  orgId        String
  repoFullName String // "owner/repo" — also the OrgMemory namespace
  path         String // ".ai/memory/0007-pglite-drift.md"
  contentHash  String // sha256(path \0 body) — the idempotency key
  entryId      String? // frontmatter `id`; null when absent (honest null, never 0)
  rawKind      String? // open vocabulary as written
  mappedKind   String // episodic | semantic | procedural
  scope        String?
  entryDate    String? // frontmatter date, VERBATIM text (repo-authored, not a timestamp)
  supersedes   String?
  refsJson     String   @default("[]") // TEXT, no jsonb (DSQL/PGlite)
  body         String // capped at 6000 chars by the parser
  headSha      String?
  superseded   Boolean  @default(false)
  orgMemoryId  String? // the OrgMemory row this fed; null = deduped or skipped
  skipReason   String? // "malformed" | "capped" | "deduped" | null
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, repoFullName, path, contentHash])
  @@index([orgId, repoFullName])
  @@index([orgId, mappedKind])
}

// #16 — one doctor run reported back by a repo (`node .ai/doctor.mjs --json`). The denormalized
// summary already lives on Repository.aiConformance*; this is the PER-CHECK ledger behind it, which
// is what turns "78%" into a fleet control matrix. See src/lib/db/org-conformance.ts.
model ConformanceReport {
  id           String   @id @default(uuid())
  orgId        String
  repoFullName String
  headSha      String? // null for older/local doctors — see the idempotency key below
  score        Int
  fails        Int
  warns        Int
  unchecked    Int      @default(0)
  scored       Int      @default(0) // the score's denominator (spec 0.2.0 field, finally stored)
  specVersion  String? // schemaVersion the reporter claimed
  runShape     String   @default("plain") // "plain" | "run"
  summaryOnly  Boolean  @default(false) // legacy payload: no findings[] travelled
  reportedAt   DateTime @default(now())

  findings ConformanceFinding[]

  @@unique([orgId, repoFullName, headSha, runShape])
  @@index([orgId, repoFullName, reportedAt])
}

// #16 — one check inside a report. This and RepoMemoryMirror are the schema's ONLY `onDelete`
// declarations (relationMode = "prisma" emulates them in the client, it emits no FK): every other
// cascade here is hand-written in retention.ts, and retention.ts deletes these two by hand as well
// rather than relying on the emulation from a bulk deleteMany that never loads the parent rows.
model ConformanceFinding {
  id       String @id @default(uuid())
  reportId String
  check    String // stable id, e.g. "control.prepush.test"
  level    String // pass | warn | fail | unchecked
  message  String @default("")

  report ConformanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([check])
}

// #19 — the registry `usage/<contributor>.json` lane, one row per (contributor, skill), UPSERTED on
// every index pass (a snapshot, never an append). Constitutionally repo-free: that lane forbids
// repository names and paths, so no repo dimension can ever be derived from it.
model OrgSkillUsageSample {
  id          String    @id @default(uuid())
  registryId  String
  orgId       String // denormalized for the org-scoped read
  contributor String // usage/<contributor>.json stem
  skillName   String // registry skill NAME (a registry-only skill has no OrgSkill id)
  invokes     Int       @default(0)
  windowDays  Int       @default(30)
  lastUsedAt  DateTime? // from the file's optional `lastUsed`; NULL = not reported
  generatedAt DateTime // the file's own generatedAt — staleness is the reader's problem
  updatedAt   DateTime  @updatedAt

  @@unique([registryId, contributor, skillName])
  @@index([orgId, skillName])
}

// #18 — one subject in a knowledge bundle's generated index. Ascent READS this lane; every field is
// owned by the bundle's own generator, so nothing here is authored by ascent.
model OrgKnowledgeSubject {
  id             String   @id @default(uuid())
  orgId          String
  registryId     String
  bundle         String
  slug           String
  category       String?
  subcategory    String?
  status         String?
  file           String
  techniqueCount Int      @default(0)
  useWhenJson    String   @default("[]") // TEXT JSON string[]
  lawsJson       String   @default("[]") // TEXT JSON string[]
  archived       Boolean  @default(false)
  indexedAt      DateTime

  @@unique([registryId, bundle, slug])
  @@index([orgId, bundle])
}

// #18 — the HEADER of one repo's `.ai/registry-map.json`: the counts and provenance of the map, so a
// reader can tell "judged 3 of 40 pairs" apart from "conformant". One row per repo.
model RepoConformanceMap {
  id                 String   @id @default(uuid())
  orgId              String
  repositoryId       String
  mapSha             String
  schema             String
  generatedAt        DateTime
  contexts           Int
  pairs              Int
  judged             Int
  deviations         Int
  weaklyGoverned     Int
  // The weakly-governed contexts BY NAME (TEXT JSON string[]), not merely how many. Director
  // addendum deferred from wave 1: the registry map states governance per context and the list is
  // NOT derivable from the counts or from RepoConformance (a context with no judged pair leaves no
  // row at all), so without this column "3 weakly governed" names nothing a reader can act on.
  weaklyGovernedJson String   @default("[]")
  unmatched          Int
  domainsJson        String   @default("[]") // TEXT JSON
  bundleDigestsJson  String   @default("{}") // TEXT JSON
  consults30d        Int? // NULL = the map carried no consult lane, which is NOT "zero consults"
  warningsJson       String   @default("[]") // TEXT JSON string[]
  ingestedAt         DateTime

  // One map header per repo. Block-level for the same reason as UsageEvent.idemKey — the emitted
  // constraint (RepoConformanceMap_repositoryId_key) is identical to the inline form's.
  @@unique([repositoryId])
  // Not in the spec's key list: the org-scoped erase sweep deletes by orgId and would otherwise scan.
  @@index([orgId])
}

// #18 — one judged (context × subject) pair from a repo's registry map: the standing deviation
// backlog, as the repo's own `/conform` runs wrote it.
model RepoConformance {
  id               String    @id @default(uuid())
  orgId            String
  repositoryId     String
  contextName      String
  contextGroup     String?
  bundle           String
  subjectSlug      String
  state            String // conformant | deviation | not-applicable | unevaluated
  confidence       String?
  score            Float?
  evidence         String? // file:line evidence exactly as the map stated it
  evaluatedAt      DateTime?
  evaluatedAgainst String?
  mapSha           String
  ingestedAt       DateTime

  @@unique([repositoryId, contextName, subjectSlug])
  @@index([orgId, subjectSlug, state])
}

// #18 — the `signals/` lane as one contributor published it. EVERY COUNT IS NULLABLE: a key the
// contributor's payload did not carry is NULL (the lane reported nothing), never 0 (nobody consulted
// it) — the two read identically in a sum and mean opposite things to a bundle maintainer.
model RegistrySignal {
  id          String   @id @default(uuid())
  orgId       String
  registryId  String
  contributor String
  app         String?
  bundle      String
  subjectSlug String
  consults    Int?
  deviations  Int?
  citResolved Int?
  citMoved    Int?
  citGone     Int?
  windowDays  Int
  generatedAt DateTime

  @@unique([registryId, contributor, bundle, subjectSlug])
  // Not in the spec's key list: the org-scoped erase sweep deletes by orgId.
  @@index([orgId, bundle])
}

// #18 — audit row: one signals contribution ascent opened back to the registry. Append-only, and
// deliberately WITHOUT a unique key beyond the id — the same payload may legitimately be
// contributed twice, and collapsing those two acts would erase half the audit trail.
model RegistrySignalContribution {
  id            String   @id @default(uuid())
  orgId         String
  registryId    String
  contributor   String
  prUrl         String?
  commitSha     String?
  payloadDigest String
  bundlesJson   String   @default("[]") // TEXT JSON
  subjects      Int
  deviations    Int
  actor         String
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
}

// #36 — one `## ` entry in `skills/<name>/LESSONS.md`. Heading slots are stored VERBATIM (a version
// that did not parse stays "" rather than being guessed) and `headingRaw` keeps the whole line, so a
// reader can always see what the parser was given.
model OrgSkillLesson {
  id           String    @id @default(uuid())
  registryId   String
  orgId        String // denormalized for the org-scoped read
  skillName    String // registry skill NAME (a registry-only skill has no OrgSkill id)
  registryPath String // "skills/<name>/LESSONS.md"
  versionUsed  String    @default("") // heading slot 1, VERBATIM ("2.1.0", "0.1-1.0", "" = unparsed)
  learnedOn    DateTime? // heading slot 2; NULL = the heading carried no readable date
  project      String    @default("") // heading slot 3, verbatim; "" = absent
  headingRaw   String // the whole "## …" line, so a reader can see what was parsed
  body         String    @default("") // the bullets under it, capped 8KB
  entryHash    String // contentDigest over headingRaw + "\n" + body — the idempotency key
  position     Int       @default(0) // 0-based order in the file (the lane is append-only)
  memoryId     String? // the OrgMemory candidate this produced; NULL = not ingested
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([registryId, registryPath, entryHash])
  @@index([orgId, skillName])
  @@index([registryId, registryPath])
}

// #36 — per-skill git timeline cache; one row per registry path, upserted. `headSha` is the cache
// key: a trace built at a different head is stale and rebuilt rather than served.
model OrgSkillTrace {
  id           String   @id @default(uuid())
  registryId   String
  orgId        String
  skillName    String
  registryPath String // "skills/<name>/SKILL.md"
  headSha      String // registry head this was built at — the cache key
  entriesJson  String   @default("[]") // TEXT JSON: [{sha, authoredAt, authorLogin, message, version|null}]
  truncated    Boolean  @default(false) // more than TRACE_COMMITS commits exist for the path
  builtAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([registryId, registryPath])
  @@index([orgId, skillName])
}

// #36 — a reflection that must land as a PR, and its state. The registry is git-native: ascent may
// PROPOSE a consolidated memory but never writes one directly, so the proposal is the durable object
// and the PR is its outcome.
model OrgMemoryProposal {
  id              String   @id @default(uuid())
  orgId           String
  registryId      String?
  namespace       String?
  kind            String   @default("summary")
  slug            String // memory/<kind>/<slug>.md stem
  summaryContent  String
  memberIdsJson   String   @default("[]") // TEXT JSON: OrgMemory ids it would supersede
  memberPathsJson String   @default("[]") // TEXT JSON: their registryPaths — what the PR's frontmatter cites
  status          String   @default("proposed") // proposed | pr_open | merged | closed
  prUrl           String?
  prNumber        Int?
  createdBy       String? // GitHub login
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId, status])
}

// #32 — a compacted month of one repo's scan history. SUMS, not means: an upsert folds a later page
// exactly, so compaction can run in pages without the arithmetic drifting. `rubricVersion` is
// NON-NULL with an "unknown" sentinel for legacy rows, because it is part of the identity key and a
// NULL there would make every legacy month a distinct bucket forever (NULLs are distinct).
model ScanDigest {
  id             String   @id @default(uuid())
  repoId         String
  period         String // UTC month bucket "YYYY-MM" (digestPeriod)
  rubricVersion  String // "unknown" sentinel for legacy rows — NEVER null (it is in the unique key)
  engineProvider String
  scanCount      Int
  overallSum     Int
  adoptionSum    Int
  rigorSum       Int
  overallMin     Int
  overallMax     Int
  overallLast    Int
  adoptionLast   Int
  rigorLast      Int
  confidenceSum  Float
  levelLast      String
  levelNameLast  String
  postureLast    String
  firstScannedAt DateTime
  lastScannedAt  DateTime
  firstHeadSha   String?
  lastHeadSha    String?
  enginesJson    String   @default("[]") // TEXT JSON string[] of distinct engineModel values
  dimensionsJson String   @default("{}") // TEXT JSON {dimId:{sum,n,last,signalSum,llmSum}} — never jsonb
  recsOpened     Int      @default(0)
  recsClosed     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id])

  @@unique([repoId, period, rubricVersion, engineProvider])
  @@index([repoId, lastScannedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// MOONSHOT WAVE 2 — the loop's outcome ledger, the practice-adoption ledger and the memory
// citation channel (docs/specs/moonshot/00-INDEX.md §5 "Wave 2"). Same three rules as wave 1: every
// JSON payload is TEXT (never jsonb — DSQL/PGlite), every MEASUREMENT column is nullable so an
// unreported figure stays UNKNOWN rather than becoming a summed zero, and the erase/purge cascades
// for these tables are hand-written in src/lib/db/retention.ts (relationMode = "prisma" emits no
// FKs, so nothing here cascades by itself).
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// #25 — what the lane's agent did with ONE recommendation it was handed, as the agent itself
// reported it in `.ascent/lane-report.json`. This is the row that stops the loop re-picking an item
// the agent already declined: `absent` (the report never mentioned the id) is a distinct verdict
// from `skipped` (it mentioned it and declined), because "we do not know" and "it said no" are
// different facts and only one of them is a reason to stop offering the item.
// STANDALONE under relationMode = "prisma": denormalized `orgId`, no DB FK — the PlaybookApplication
// / ImprovementPr posture. See src/lib/db/lane-outcomes.ts.
model LaneItemOutcome {
  id               String    @id @default(uuid())
  orgId            String
  runId            String
  laneId           String
  repoFullName     String
  recommendationId String
  cycle            Int
  // resolved | skipped | needs_human | attempted | absent
  verdict          String
  reason           String    @default("") // the agent's own words; "" = it gave none, never a guess
  filesJson        String    @default("[]") // TEXT JSON string[] of paths the agent claimed to touch
  deferUntil       DateTime? // null = not deferred. A deferral is per-ITEM, never a schedule.
  createdAt        DateTime  @default(now())

  // One verdict per (lane, item) — the idempotency key, so re-parsing the same report is a no-op.
  @@unique([laneId, recommendationId])
  @@index([orgId, recommendationId])
  @@index([runId])
}

// #25 — a lesson a lane proposed for the org's memory, held in REVIEW rather than written straight
// into OrgMemory: an agent's summary of its own work is a claim, and promoting it unreviewed would
// let a loop teach the organization something no human ever agreed to. `promotedMemoryId` records
// the OrgMemory row a kept candidate became, so the provenance survives the promotion.
// Deliberately generic (`source` is an open string): #36's skill-lessons channel can reuse this
// table rather than fork a second one.
model OrgMemoryCandidate {
  id               String    @id @default(uuid())
  orgId            String
  namespace        String? // optional in-org grouping tag; null = org-wide (OrgMemory's rule)
  content          String
  kind             String    @default("procedural") // episodic | semantic | procedural | summary
  source           String // provenance: "loop-lesson", "skill-lessons", …
  laneId           String? // the LoopRunLane that proposed it; null = another channel did
  status           String    @default("pending") // pending | kept | discarded
  promotedMemoryId String? // the OrgMemory row a `kept` candidate became; null until promoted
  reviewedBy       String? // GitHub login that decided; null while pending
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([orgId, status])
}

// #33 — one practice artifact ascent PROPOSED to a repo, and what happened to it afterwards. The
// hashes are the whole point: `proposedHash` is what ascent committed to the PR branch and
// `adoptedHash` is what the file actually looks like now, so `drifted` is a MEASURED divergence
// rather than an assumption that a merged PR stayed merged. `adoptedHash` stays NULL until the
// first post-merge scan reads the file — null is "not yet observed", never "unchanged".
model PracticeAdoption {
  id              String    @id @default(uuid())
  orgId           String
  repoFullName    String
  practiceId      String // catalog id | "registry:<slug>" | "playbook:<uuid>"
  source          String // generic | house | registry | playbook
  patternVersion  Int? // HousePatternVersion.version when source = house; NULL otherwise
  artifactPath    String
  proposedHash    String // sha256-n1 of the body ascent committed to the PR branch
  adoptedHash     String? // sha256-n1 of the file as it LANDED; NULL until the first post-merge scan
  adoptedOutline  String? // sha256-n1 over the landed file's normalized heading outline
  state           String    @default("proposed") // proposed | adopted | drifted | removed | superseded
  improvementPrId String? // read-only join to the ImprovementPr this came from
  prNumber        Int?
  adoptedAt       DateTime?
  driftedAt       DateTime?
  lastCheckedAt   DateTime?
  lastScanId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, repoFullName, practiceId, artifactPath])
  @@index([orgId, state])
  @@index([orgId, practiceId, patternVersion])
}

// #33 — an immutable version of an org's own mined "house pattern" for a practice. Versioned rather
// than overwritten because an adoption row cites the version it was measured against: re-mining the
// pattern must not retroactively turn every previously-conformant repo into a drifted one.
// `patternHash` (over linesJson) is the change key — a re-mine that produces the same lines writes
// no new version at all.
model HousePatternVersion {
  id            String   @id @default(uuid())
  orgId         String
  practiceId    String
  version       Int // 1-based, per (orgId, practiceId)
  linesJson     String   @default("[]") // TEXT JSON string[] — minedStarter() output
  exemplarsJson String   @default("[]") // TEXT JSON string[] — repo fullNames that agreed
  agreementMin  Int      @default(2) // MIN_AGREEMENT in force when this version was mined
  patternHash   String // sha256-n1 over linesJson — the change key
  minedAt       DateTime @default(now())

  @@unique([orgId, practiceId, version])
  @@unique([orgId, practiceId, patternHash])
  @@index([orgId, practiceId])
}

// #17 — an agent telling ascent what it actually USED. One row per (memory, session): the unique key
// makes a chatty agent's repeated reads ONE citation, so `OrgMemory.citedCount` counts sessions that
// used a memory rather than calls that mentioned it. `used = false` is a first-class fact (the agent
// read it and it did not help) and is counted separately in `notUsefulCount` — never netted against
// the positive count. Written only through the plan-gated, scope-gated MCP write door, which also
// writes the AuditLog row beside it; see src/lib/db/org-memory-citations.ts.
model OrgMemoryCitation {
  id        String   @id @default(uuid())
  orgId     String
  memoryId  String
  tokenId   String? // the OrgApiToken that carried the write; null = a non-token actor
  actor     String // the caller's declared identity (agent name / login)
  sessionId String // the agent's own session id — the dedupe dimension, not a join to AgentSession
  used      Boolean
  note      String? // the agent's one-line reason; null = it gave none
  source    String   @default("mcp") // mcp | web | cli — where the citation entered
  createdAt DateTime @default(now())

  @@unique([memoryId, sessionId])
  @@index([orgId, createdAt])
  @@index([memoryId, used])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// MOONSHOT WAVE 3 — the two-speed scan queue and the governance evidence ledger
// (docs/specs/moonshot/00-INDEX.md §5 "Wave 3"). Same three rules as waves 1 and 2: every JSON
// payload is TEXT (never jsonb — DSQL/PGlite), a value nobody measured stays NULL rather than
// becoming a zero, and the erase/purge cascades are hand-written in src/lib/db/retention.ts
// (relationMode = "prisma" emits no FKs, so nothing here cascades by itself).
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// #10 — one unit of queued scan work. The queue exists because the cron worker used to hold the whole
// fleet in one invocation: a rescan either finished inside the function's cap or was lost with no
// record that it had been attempted. A row survives the invocation, so "queued", "claimed by an
// invocation that died" and "settled" are distinguishable states rather than the same silence.
//
// `idempotencyKey` is the enqueue contract: "<orgId>|<repoFullName>|<lane>|<bucket>". Two producers
// racing on the same repo in the same bucket (a cadence tick and a webhook, say) collide on the unique
// index and the second enqueue is a no-op instead of a second charged scan. It is declared BLOCK-level
// (@@unique([idempotencyKey]), not an inline @unique) deliberately: Prisma emits the same
// `ScanJob_idempotencyKey_key` index either way, and the block form keeps the pinned inline-@unique
// parity list in src/lib/db/init-sql.test.ts intact — the same reason OrgSkillDownload states.
//
// `claimedBy` is an invocation id for DIAGNOSTICS only and is never an authorization input: a claim is
// held by the lease (`leaseUntil`), so a worker that died mid-job has its row re-claimed on expiry
// rather than being trusted to release it.
model ScanJob {
  id             String    @id @default(uuid())
  orgId          String
  repoId         String? // null while the import funnel has not created the Repository row yet
  repoFullName   String // "owner/name", always present — the identity the claim keys on
  lane           String // rescore | probe
  reason         String // cadence | manual | import | continuation | webhook:<event>
  state          String    @default("queued") // queued | claimed | done | failed | skipped
  priority       Int       @default(0) // higher first; manual = 10, webhook = 5, cadence = 0
  runId          String? // groups one interactive /api/org/scan batch
  idempotencyKey String // "<orgId>|<repoFullName>|<lane>|<bucket>" — see the header
  notBefore      DateTime  @default(now())
  claimedAt      DateTime?
  claimedBy      String? // invocation id — diagnostics only, never an authorization input
  leaseUntil     DateTime?
  attempts       Int       @default(0)
  creditCharged  Boolean   @default(false) // rescore only: an overflow credit is held BY THIS ROW
  resultJson     String? // TEXT JSON (no jsonb — DSQL/PGlite)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  settledAt      DateTime? // when the row reached done | failed | skipped — the purge horizon's anchor

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([idempotencyKey])
  @@index([lane, state, notBefore, priority])
  @@index([orgId, lane, state])
  @@index([runId])
  @@index([state, leaseUntil])
}

// #1 + #10, reconciled (00-INDEX §5, conflict W3-#1) — append-only evidence: "control X on repo Y was
// in state S at time T, and here is how we know". One row is one OBSERVATION, never a current-state
// cache: the posture surfaces read the newest row per (repoFullName, controlId), so an observation is
// never updated in place and the history stays re-derivable.
//
// `state` is pass | fail | unmeasurable and `unmeasurable` is NEVER coerced to `fail` — "we could not
// see it" and "it is off" are different claims, and an evidence pack that conflates them is inventing
// findings. `value` carries the measured scalar ("2" approvals, "4" rules) and `prevValue`/`prevState`
// the ones this row superseded; both are null on a pair's first observation, which is a fact rather
// than a zero. `transition` is the derived "state != prevState" flag the alert path reads, stored
// rather than recomputed so an alert query does not have to self-join the timeline.
//
// `occurredAt` vs `observedAt` is the split the whole ledger turns on: when the state HELD (or the
// change happened, per the webhook payload) vs when THIS deployment learned it. A probe backfilling a
// week-old ruleset change has an old `occurredAt` and a fresh `observedAt`, and reporting either as
// the other misdates an auditor's evidence. `actorLogin` is populated for webhook rows ONLY and is
// never fabricated for a scan or probe row — nobody "did" a periodic measurement.
//
// `repoId` is nullable for org-scoped controls (an org SECURITY.md is not a repo's fact) while
// `repoFullName` is always present and DENORMALIZED, so the pack and the timeline read never joins.
// `deliveryId` is GitHub's X-GitHub-Delivery: the unique below makes a webhook REDELIVERY a no-op
// rather than a duplicated observation. `sig` is signAudit() over the canonical fields; null means
// signing is off on this deployment, never "the signature failed".
model ControlObservation {
  id           String   @id @default(uuid())
  orgId        String
  repoId       String? // null = an org-scoped control
  repoFullName String // denormalized: the pack/timeline read never joins
  controlId    String // catalog id, e.g. "branch-protection"
  state        String // pass | fail | unmeasurable — never inferred
  value        String? // the measured value ("2", "true"); null when unmeasurable
  prevValue    String? // null on the first observation for the pair
  prevState    String? // the state this row superseded; null on the first observation
  evidenceJson String   @default("{}") // TEXT JSON: rule types, branch, actor — the citable slice
  source       String // scan | probe | webhook | baseline
  actorLogin   String? // webhook only; NEVER fabricated for scan/probe
  transition   Boolean  @default(false) // true iff state != prevState — the row the alert path reads
  occurredAt   DateTime // when the state held / the change happened
  observedAt   DateTime @default(now()) // when we learned it
  scanId       String?
  jobId        String? // the ScanJob that produced it; null for scan/webhook rows
  deliveryId   String? // GitHub X-GitHub-Delivery — the redelivery idempotency key
  sig          String? // signAudit() over the canonical fields; null = signing off
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([deliveryId, controlId, repoFullName])
  @@index([orgId, repoFullName, controlId, occurredAt])
  @@index([orgId, occurredAt])
  @@index([repoId, controlId, observedAt])
  @@index([orgId, transition, observedAt])
}

// #1 — one seal per (org, UTC day): a hash chain over DAYS, not over rows. Chaining rows would make
// every append a read-modify-write on the previous row's digest; chaining days seals a closed window
// once and leaves the append path untouched.
//
// `rowCount` and `root` are what make a DELETION detectable: the ledger's retention purge removes aged
// observations but NEVER their seal (src/lib/db/retention.ts), so a sealed day whose surviving rows no
// longer reproduce its root is visibly incomplete rather than silently short. That is the difference
// between "this evidence was retained" and "this evidence is all there ever was".
model ControlLedgerSeal {
  id       String   @id @default(uuid())
  orgId    String
  day      String // YYYY-MM-DD (UTC)
  rowCount Int
  root     String // sha256 over the day's sorted per-row digests
  prevRoot String? // the previous sealed day's root; null = the chain's first day
  sealedAt DateTime @default(now())
  sig      String? // HMAC over {orgId, day, rowCount, root, prevRoot}; null = signing off

  @@unique([orgId, day])
  @@index([orgId, day])
}
